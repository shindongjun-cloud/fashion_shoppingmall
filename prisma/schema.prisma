// 데이터베이스 설계도입니다. 여기서 "model" 하나가 표(테이블) 하나가 됩니다.
// 수정한 뒤에는 `npm run db:migrate`로 실제 데이터베이스에 반영하세요.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 상품
model Product {
  id          Int      @id @default(autoincrement()) // 1, 2, 3... 자동 번호
  name        String
  price       Int // 원 단위
  category    String
  emoji       String // 이미지 대신 쓰는 이모지
  color       String // 카드 배경색 (Tailwind 클래스)
  description String
  createdAt   DateTime @default(now())

  orderItems OrderItem[] // 이 상품이 들어간 주문 항목들
}

// 주문 (5단계 결제에서 사용)
model Order {
  id             Int      @id @default(autoincrement())
  paymentOrderId String   @unique // 토스페이먼츠에 보내는 주문번호 (영문/숫자 6~64자)
  orderName      String // 결제창에 보이는 이름. 예: "러닝 스니커즈 외 2건"
  totalPrice     Int // 서버가 DB 가격으로 계산한 금액
  status         String   @default("PENDING") // PENDING(결제 대기) → PAID(결제 완료)
  paymentKey     String? // 결제 승인 후 토스가 준 결제 키 (환불할 때 필요)
  createdAt      DateTime @default(now())
  userId         String // 주문한 사람

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

// 주문 안의 상품 한 줄 (어떤 주문에, 어떤 상품을, 몇 개)
model OrderItem {
  id        Int @id @default(autoincrement())
  quantity  Int
  price     Int // 주문 당시 가격 (나중에 상품 가격이 바뀌어도 기록은 그대로)
  orderId   Int
  productId Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ---------------------------------------------------------------
// 로그인(Auth.js)용 표들. Auth.js가 정한 형태 그대로 써야 합니다.
// ---------------------------------------------------------------

// 회원
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String? // 프로필 사진 주소 (GitHub 아바타)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

// 어떤 외부 서비스(GitHub 등) 계정으로 로그인했는지
model Account {
  userId            String
  type              String
  provider          String // 예: "github"
  providerAccountId String // GitHub에서의 사용자 번호
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// 로그인 상태 (브라우저 쿠키에 sessionToken이 저장됩니다)
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 이메일 로그인용 (지금은 사용하지 않지만 Auth.js 어댑터가 요구합니다)
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
