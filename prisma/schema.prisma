// 데이터베이스 설계도입니다. 여기서 "model" 하나가 표(테이블) 하나가 됩니다.
// 수정한 뒤에는 `npm run db:migrate`로 실제 데이터베이스에 반영하세요.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ⚠️ DB 제약조건(CHECK·트리거)은 Prisma 문법으로 쓸 수 없어서 prisma/db-constraints.ts에 따로 정의합니다.
//    마이그레이션 SQL을 만든 뒤 `npm run db:constraints -- <migration.sql>`로 주입하고,
//    `npm run db:verify`로 제약이 살아 있는지·데이터가 규칙을 지키는지 확인합니다.

// ===============================================================
// 상품 도메인 (B안: 스타일 → 컬러 → SKU 3단 구조)
//
//   Style (JK26F001 울 블렌드 싱글 자켓)          ← 상세페이지 1개
//    └─ StyleColor (JK26F001-BK 블랙)             ← 컬러별 사진·판매상태
//        └─ Sku (JK26F001-BK-100)                 ← 재고·주문의 실제 단위
//
// 마스터(기준 정보): Season, Category, Color, SizeGroup, Size, Material, Manufacturer, CareSymbol
// 상세 정보: StyleColorImage, StyleMaterial, SizeMeasurement, ModelWear, StyleNotice,
//            StyleCare, StyleWearSeason, StyleDetailBlock
// ===============================================================

// ---------- 코드값(enum): 정해진 값만 들어가게 막습니다 ----------

// 성별 구분
enum Gender {
  MEN
  WOMEN
  UNISEX
}

// 스타일 판매 상태. "품절"은 상태로 두지 않고 재고(Sku.stock)로 계산합니다.
// (상태로 두면 재고가 들어와도 누가 상태를 바꿔줘야 해서 어긋나기 쉬움)
enum StyleStatus {
  DRAFT // 작성 중 (고객에게 안 보임)
  ON_SALE // 판매 중
  SUSPENDED // 일시 중지
  DISCONTINUED // 판매 종료 (주문 내역 때문에 삭제하지 않음)
}

// 컬러·SKU 단위 판매 상태
enum SaleStatus {
  ON_SALE
  SUSPENDED
  DISCONTINUED
}

// 시즌 구분
enum SeasonTerm {
  SS // Spring/Summer 봄·여름
  FW // Fall/Winter 가을·겨울
  ALL // 시즌 없는 상시 판매(캐리오버)
}

// 컬러 계열 (필터용). "차콜"과 "그레이"는 모두 GRAY 계열
enum ColorFamily {
  BLACK
  WHITE
  GRAY
  BEIGE
  BROWN
  NAVY
  BLUE
  GREEN
  RED
  PINK
  YELLOW
  PURPLE
  MULTI
}

// 핏
enum Fit {
  SLIM
  REGULAR
  RELAXED
  OVERSIZED
}

// 두께감 / 신축성 / 비침 / 안감에 공통으로 쓰는 3단계
enum Level3 {
  LOW
  MEDIUM
  HIGH
}

// 안감
enum Lining {
  NONE
  PARTIAL
  FULL
}

// 상품정보제공고시 품목군 (전자상거래법상 의무 표시 항목의 종류)
enum NoticeType {
  CLOTHING // 의류
  SHOES // 구두/신발
  BAG // 가방
  ACCESSORY // 패션잡화(모자/벨트/액세서리)
}

// 이미지 종류
enum ImageType {
  MAIN // 대표(정면) - 목록 카드에 사용
  BACK // 후면
  MODEL // 모델 착용
  DETAIL // 디테일 컷
}

// 소재 분류
enum MaterialKind {
  NATURAL // 천연 (면, 울, 린넨)
  SYNTHETIC // 합성 (폴리에스터, 나일론)
  REGENERATED // 재생 (레이온, 텐셀)
  LEATHER // 가죽
  OTHER // 고무 등
}

// 제조사 역할 (고시 정보의 "제조자(수입자)")
enum ManufacturerRole {
  MANUFACTURER // 제조사
  IMPORTER // 수입사
}

// 세탁 기호 분류 (KS 세탁 표시 기준의 큰 묶음)
enum CareCategory {
  WASH // 물세탁
  BLEACH // 표백
  DRY // 건조
  IRON // 다림질
  DRYCLEAN // 드라이클리닝
}

// 착용 계절감 (Season 테이블은 "출시 시즌", 이것은 "입기 좋은 계절")
enum WearSeason {
  SPRING
  SUMMER
  FALL
  WINTER
}

// 상세페이지 콘텐츠 블록 종류
enum DetailBlockType {
  TEXT // 제목 + 본문
  IMAGE // 이미지 1장 (+ 캡션)
  VIDEO // 영상 주소
}

// 실측 항목 (단위 cm)
enum MeasureItem {
  SHOULDER // 어깨너비
  CHEST // 가슴단면
  SLEEVE // 소매길이
  LENGTH // 총장
  WAIST // 허리단면
  HIP // 엉덩이단면
  THIGH // 허벅지단면
  RISE // 밑위
  HEM // 밑단단면
  HEAD // 머리둘레
  BRIM // 챙길이
  DEPTH // 깊이
}

// ---------- 마스터 테이블 ----------

// 시즌: 26SS, 26FW ... (어느 시즌에 기획·출시한 상품인지)
model Season {
  id        Int        @id @default(autoincrement())
  code      String     @unique // 26FW
  name      String // 2026 가을/겨울
  year      Int // 2026
  term      SeasonTerm
  startDate DateTime? // 시즌 판매 시작일
  endDate   DateTime? // 시즌 판매 종료일 (이후 이월상품)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  styles           Style[]
  promotionTargets PricePromotionTarget[]
  couponTargets    CouponPolicyTarget[]
}

// 표준 카테고리 트리: 아우터 > 자켓
// - parentId: 바로 위 부모 (인접 리스트)
// - path: 루트부터의 id 경로 "/1/4/" → 하위 전체 조회가 쉬움 (path LIKE '/1/%')
// 성별(남성/여성)은 여기 넣지 않고 Style.gender로 구분합니다.
// "남성 > 아우터" 같은 고객용 메뉴는 11번 전시 단계에서 따로 만듭니다.
model Category {
  id         Int         @id @default(autoincrement())
  parentId   Int?
  code       String      @unique // OUTER_JACKET (URL·연동용 고정 코드)
  name       String // 자켓
  path       String      @default("/") // /1/4/ — DB 트리거(Category_path_fill)가 부모 기준으로 자동 계산
  depth      Int         @default(1) // 1 = 대분류, 2 = 중분류 — 트리거가 자동 계산
  noticeType NoticeType? // 이 카테고리 상품의 기본 고시 품목군
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  parent           Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict) // 자식이 있으면 삭제 거부 (고아 카테고리 방지)
  children         Category[]             @relation("CategoryTree")
  styles           Style[]
  promotionTargets PricePromotionTarget[]
  couponTargets    CouponPolicyTarget[]

  @@index([parentId])
  @@index([path])
}

// 컬러 마스터: 이름을 통일하고, 컬러칩 색과 계열(필터)을 관리
model Color {
  id        Int         @id @default(autoincrement())
  code      String      @unique // BK (품번에 들어가는 2자리 코드)
  name      String // 블랙
  nameEn    String // BLACK
  hex       String // #1A1A1A (컬러칩 표시용)
  family    ColorFamily // BLACK 계열
  sortOrder Int         @default(0)

  styleColors StyleColor[]
}

// 사이즈 체계: 상의(숫자), 상의(알파벳), 하의(인치), 신발(mm), FREE
model SizeGroup {
  id   Int    @id @default(autoincrement())
  code String @unique // TOP_KR
  name String // 상의 (95~110)

  sizes          Size[]
  styles         Style[]
  purchaseOrders PurchaseOrder[] // 이 거래처에 낸 발주
}

// 개별 사이즈. sortOrder로 정렬해야 "95, 100, 105" 순서가 보장됩니다.
// (문자열로 정렬하면 "100, 105, 95"가 됨)
model Size {
  id          Int    @id @default(autoincrement())
  sizeGroupId Int
  code        String // 100
  label       String // 100 (L)
  sortOrder   Int

  sizeGroup    SizeGroup         @relation(fields: [sizeGroupId], references: [id])
  skus         Sku[]
  measurements SizeMeasurement[]
  modelWears   ModelWear[]

  @@unique([sizeGroupId, code])
  @@unique([sizeGroupId, sortOrder]) // 같은 체계 안에서 정렬 순서 중복 금지
}

// 소재 마스터: "울", "WOOL", "양모"가 따로 생기지 않게 이름을 통일합니다.
model Material {
  id        Int          @id @default(autoincrement())
  code      String       @unique // WOOL
  name      String // 울
  nameEn    String // Wool
  kind      MaterialKind // 천연 / 합성 / 재생 / 가죽
  sortOrder Int          @default(0)

  styleMaterials StyleMaterial[]
}

// 제조사·수입사 마스터 (상품정보제공고시의 "제조자(수입자)", 생산 협력사 관리)
model Manufacturer {
  id           Int              @id @default(autoincrement())
  code         String           @unique // MYSHOP
  name         String // (주)마이샵
  role         ManufacturerRole
  country      String // 회사 소재 국가 (제조국과 다를 수 있음)
  contactPhone String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())

  styles         Style[]
  purchaseOrders PurchaseOrder[]
}

// 세탁 기호 마스터: 아이콘 + 설명
model CareSymbol {
  id        Int          @id @default(autoincrement())
  code      String       @unique // HAND_WASH_30
  category  CareCategory
  name      String // 30℃ 손세탁
  icon      String // 화면 표시용 아이콘 (나중에 이미지 주소로 교체 가능)
  sortOrder Int          @default(0)

  styles StyleCare[]
}

// ---------- 핵심 3단 구조 ----------

// 스타일 = 우리가 흔히 "상품"이라고 부르는 단위. 상세페이지 1개, 리뷰도 여기에 모입니다.
model Style {
  id             Int     @id @default(autoincrement())
  styleCode      String  @unique // JK26F001 (품번, URL에도 사용)
  name           String // 울 블렌드 싱글 자켓
  summary        String? // 한 줄 소개 (목록·공유용)
  description    String // 상세 설명
  gender         Gender
  categoryId     Int
  seasonId       Int?
  sizeGroupId    Int // 이 스타일이 쓰는 사이즈 체계
  manufacturerId Int? // 제조사·수입사

  // 구매·판매 조건
  maxQtyPerOrder   Int? // 1회 주문 최대 수량 (한정 상품). 없으면 제한 없음
  preorderShipDate DateTime? // 예약 판매 출고 예정일. 있으면 "예약 판매" 상품

  // 검색엔진(SEO)용. 비어 있으면 name / summary를 대신 씁니다.
  metaTitle       String?
  metaDescription String?

  // 가격은 Style에 두지 않습니다.
  // 정가 → StylePrice(이력), 판매가 → 정가 + 할인 행사(PricePromotion)로 계산 (lib/pricing.ts)

  // 패션 속성: 필터·상세 표시용이라 정식 컬럼으로 둡니다.
  fit       Fit?
  thickness Level3? // 두께감
  stretch   Level3? // 신축성
  sheerness Level3? // 비침
  lining    Lining? // 안감

  // 판매 상태와 전시 여부는 분리 (판매 중이지만 숨겨둘 수 있음)
  status      StyleStatus @default(DRAFT)
  isDisplayed Boolean     @default(false)
  releasedAt  DateTime? // 출시일 (NEW 판단 기준)
  saleStartAt DateTime? // 예약 오픈
  saleEndAt   DateTime?

  deletedAt DateTime? // 소프트 삭제 (주문이 참조하므로 실제로 지우지 않음)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  category         Category               @relation(fields: [categoryId], references: [id])
  season           Season?                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  sizeGroup        SizeGroup              @relation(fields: [sizeGroupId], references: [id])
  manufacturer     Manufacturer?          @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  colors           StyleColor[]
  materials        StyleMaterial[]
  measurements     SizeMeasurement[]
  modelWears       ModelWear[]
  notice           StyleNotice?
  cares            StyleCare[]
  wearSeasons      StyleWearSeason[]
  detailBlocks     StyleDetailBlock[]
  prices           StylePrice[]
  promotionTargets PricePromotionTarget[]
  couponTargets    CouponPolicyTarget[]

  @@index([categoryId])
  @@index([status, isDisplayed])
}

// 스타일 × 컬러 (컬러웨이). 사진·품절·출시일이 컬러마다 다르기 때문에 독립 단위입니다.
// 정렬 순서가 가장 앞인 컬러가 "대표 컬러"가 됩니다.
model StyleColor {
  id          Int        @id @default(autoincrement())
  styleId     Int
  colorId     Int
  code        String     @unique // JK26F001-BK
  colorLabel  String? // 마케팅 컬러명 (예: "딥 블랙"). 없으면 Color.name 사용
  status      SaleStatus @default(ON_SALE)
  isDisplayed Boolean    @default(true)
  releasedAt  DateTime? // 컬러 추가 출시일 (나중에 나온 컬러)
  sortOrder   Int        @default(0)

  style      Style             @relation(fields: [styleId], references: [id])
  color      Color             @relation(fields: [colorId], references: [id])
  skus       Sku[]
  images     StyleColorImage[]
  modelWears ModelWear[]

  @@unique([styleId, colorId]) // 같은 스타일에 같은 컬러 중복 금지
  @@unique([styleId, sortOrder]) // 정렬 순서 중복 금지 → "0번 = 대표 컬러"가 항상 1개
}

// SKU (Stock Keeping Unit) = 컬러 × 사이즈. 재고·장바구니·주문의 실제 단위
model Sku {
  id           Int        @id @default(autoincrement())
  styleColorId Int
  sizeId       Int
  skuCode      String     @unique // JK26F001-BK-100
  barcode      String?    @unique // 바코드 (매장 POS·물류용)
  status       SaleStatus @default(ON_SALE)
  // 재고는 Sku에 두지 않습니다 → InventoryBalance(위치별 잔고) / InventoryLedger(원장) / InventoryReservation(예약)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  styleColor           StyleColor             @relation(fields: [styleColorId], references: [id])
  size                 Size                   @relation(fields: [sizeId], references: [id])
  orderItems           OrderItem[]
  balances             InventoryBalance[]
  ledgers              InventoryLedger[]
  reservations         InventoryReservation[]
  purchaseLines        PurchaseOrderLine[]
  inboundLines         InboundReceiptLine[]
  restockSubscriptions RestockSubscription[]
  stockAlerts          StockAlert[]

  @@unique([styleColorId, sizeId]) // 같은 컬러에 같은 사이즈 중복 금지
}

// ---------- 상세 정보 ----------

// 컬러별 이미지. 컬러칩을 누르면 이 컬러의 이미지로 바뀝니다.
// 파일은 저장소(CDN)에 두고 DB에는 주소만 저장합니다.
model StyleColorImage {
  id           Int       @id @default(autoincrement())
  styleColorId Int
  url          String
  type         ImageType
  alt          String // 대체 텍스트 (접근성·SEO)
  sortOrder    Int       @default(0)

  styleColor StyleColor @relation(fields: [styleColorId], references: [id], onDelete: Cascade)

  @@index([styleColorId, sortOrder])
}

// 혼용률: 겉감 울 70% / 폴리에스터 30%, 안감 폴리에스터 100%
model StyleMaterial {
  id         Int    @id @default(autoincrement())
  styleId    Int
  part       String // 겉감 / 안감 / 배색 / 충전재
  materialId Int // 소재 마스터 (글자로 직접 쓰지 않음)
  percent    Int // 70  (같은 part의 합은 100)
  sortOrder  Int    @default(0)

  style    Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@index([styleId])
  @@index([materialId]) // "울이 들어간 상품" 찾기용
}

// 스타일 × 세탁 기호 (N:M 매핑)
model StyleCare {
  styleId      Int
  careSymbolId Int
  sortOrder    Int @default(0)

  style      Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)
  careSymbol CareSymbol @relation(fields: [careSymbolId], references: [id])

  @@id([styleId, careSymbolId]) // 같은 기호 중복 금지
}

// 스타일 × 착용 계절 (N:M). 값이 4개로 고정이라 마스터 테이블 대신 enum을 씁니다.
model StyleWearSeason {
  styleId Int
  season  WearSeason

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([styleId, season])
  @@index([season]) // "가을에 입는 상품" 필터용
}

// 상세페이지 콘텐츠 블록: 텍스트·이미지·영상을 순서대로 쌓아 상세페이지를 만듭니다.
// 통이미지 한 장보다 수정이 쉽고, 텍스트가 검색엔진에 읽힙니다.
model StyleDetailBlock {
  id        Int             @id @default(autoincrement())
  styleId   Int
  type      DetailBlockType
  title     String? // TEXT: 소제목
  body      String? // TEXT: 본문 / IMAGE: 캡션
  mediaUrl  String? // IMAGE·VIDEO: 주소
  alt       String? // IMAGE: 대체 텍스트
  sortOrder Int             @default(0)
  isVisible Boolean         @default(true)

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId, sortOrder])
}

// 사이즈별 실측 (스타일 × 사이즈 × 항목 = cm). 실측표를 자동으로 만들 수 있습니다.
model SizeMeasurement {
  id      Int         @id @default(autoincrement())
  styleId Int
  sizeId  Int
  item    MeasureItem
  valueCm Float // 52.5

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)
  size  Size  @relation(fields: [sizeId], references: [id])

  @@unique([styleId, sizeId, item])
}

// 모델 착용 정보: "모델 183cm / 72kg, 100 사이즈 착용"
model ModelWear {
  id           Int     @id @default(autoincrement())
  styleId      Int
  styleColorId Int? // 어떤 컬러를 입었는지 (선택)
  sizeId       Int // 착용 사이즈
  modelName    String?
  heightCm     Int
  weightKg     Int?
  note         String? // "평소 100 착용, 여유 있게 입음"

  style      Style       @relation(fields: [styleId], references: [id], onDelete: Cascade)
  styleColor StyleColor? @relation(fields: [styleColorId], references: [id], onDelete: SetNull) // 컬러가 지워지면 "컬러 정보 없음"으로 (의도된 SetNull)
  size       Size        @relation(fields: [sizeId], references: [id])

  @@index([styleId])
}

// 상품정보제공고시 (전자상거래법 의무). 품목군마다 항목이 달라서 JSON으로 저장합니다.
// 검색·필터에 쓰지 않는 "보여주기만 하는" 정보라 JSON이 적합합니다.
model StyleNotice {
  styleId    Int        @id // 스타일과 1:1
  noticeType NoticeType
  content    Json // [{ "label": "제조국", "value": "대한민국" }, ...]
  updatedAt  DateTime   @updatedAt

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)
}

// ===============================================================
// 가격 도메인 (C안: 정가 이력 + 할인 행사 규칙 분리)
//
//   판매가 = 정가(StylePrice, 지금 유효한 행)
//          − 지금 적용 가능한 할인 행사(PricePromotion) 중 할인이 가장 큰 1개
//   판매가는 저장하지 않고 계산합니다 (lib/pricing.ts).
//   → 행사 시작·종료가 시각에 맞춰 자동으로 반영됩니다.
// ===============================================================

// 정가 변경 사유
enum PriceChangeReason {
  INITIAL // 최초 등록
  REPRICE // 정책상 가격 조정 (시즌 재책정 등)
  COST_CHANGE // 원가 변동 (원자재·환율)
  ERROR_FIX // 잘못 입력한 가격 정정
}

// 할인 방식
enum DiscountType {
  RATE // 정률: 정가의 N% 할인
  AMOUNT // 정액: N원 할인
  FIXED_PRICE // 균일가: N원에 판매 (예: 전 품목 39,000원)
}

// 행사 상태. "예정 / 진행 중 / 종료"는 저장하지 않고 기간(startAt~endAt)으로 계산합니다.
// (품절을 재고로 계산하는 것과 같은 원리: 사람이 상태를 바꾸지 않아도 시각에 맞춰 바뀜)
enum PromotionStatus {
  DRAFT // 작성 중 (적용 안 됨)
  APPROVED // 확정. 기간 안이면 자동 적용
  PAUSED // 일시 중지 (가격 오류 등 긴급 상황)
  CANCELED // 취소 (기록은 남김)
}

// 할인 대상 종류
enum PromotionTargetType {
  ALL // 전체 상품
  CATEGORY // 카테고리 (하위 카테고리 포함)
  SEASON // 시즌 (26SS 시즌오프)
  GENDER // 성별 (남성 전체)
  STYLE // 특정 스타일
}

// 포함 / 제외
enum TargetMode {
  INCLUDE
  EXCLUDE // "전체 30%, 단 신상은 제외"
}

// 끝자리 처리 방식
enum RoundingMode {
  FLOOR // 내림 (고객에게 유리, 가장 흔함)
  ROUND // 반올림
  CEIL // 올림
}

// 정가 이력 (SCD Type 2: 덮어쓰지 않고 기간이 있는 행을 계속 추가)
// 지금 정가 = validFrom <= 지금 < validTo (validTo가 비어 있으면 현재 적용 중)
// 할인율을 표시하려면 "할인 전 가격에 실제로 팔았던 근거"가 필요해서, 이 이력이 법적 근거가 됩니다.
model StylePrice {
  id        Int               @id @default(autoincrement())
  styleId   Int
  listPrice Int // 정가 (택가, 부가세 포함)
  currency  String            @default("KRW") // 통화 (해외몰 대비)
  validFrom DateTime // 적용 시작
  validTo   DateTime? // 적용 종료 (null = 현재 가격)
  reason    PriceChangeReason
  memo      String? // "원단 단가 8% 인상 반영"
  changedBy String? // 변경한 관리자 (관리자 단계에서 FK로 연결)
  createdAt DateTime          @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Restrict) // 가격 이력은 법적 근거라 함께 지우지 않음

  @@index([styleId, validFrom]) // "이 스타일의 지금 가격" 조회용
}

// 할인 행사: 행사 1개 = 규칙 1개. 대상 상품이 300개여도 행은 1개입니다.
model PricePromotion {
  id          Int     @id @default(autoincrement())
  code        String  @unique // 26SS_SEASON_OFF (내부 관리 코드)
  name        String // 26SS 시즌오프 (관리자용 이름)
  displayName String // 시즌오프 (고객에게 보이는 이름, 주문 내역 표시)
  description String? // 행사 설명 (관리자 메모)

  // 할인 규칙
  discountType      DiscountType
  discountValue     Int // RATE: 30(%) / AMOUNT: 10000(원) / FIXED_PRICE: 39000(원)
  maxDiscountAmount Int? // 정률 할인의 최대 할인 금액 (예: 최대 3만원까지)
  minListPrice      Int? // 정가 N원 이상 상품에만 적용
  roundingUnit      Int          @default(100) // 판매가 끝자리 단위 (10 / 100 / 1000원)
  roundingMode      RoundingMode @default(FLOOR)

  // 기간과 상태
  startAt  DateTime
  endAt    DateTime // 이 시각 직전까지 적용 (startAt <= 지금 < endAt)
  status   PromotionStatus @default(DRAFT)
  priority Int             @default(0) // 할인액이 같을 때 높은 쪽 우선

  // 화면 표시
  badgeText   String? // 상품 카드 뱃지 "SEASON OFF"
  showEndDate Boolean @default(false) // 상세에 "~11/30 종료" 표시

  // 관리 정보 (관리자 단계에서 FK로 연결)
  createdBy  String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  targets    PricePromotionTarget[]
  orderItems OrderItem[]

  @@index([status, startAt, endAt]) // "지금 진행 중인 행사" 조회용
}

// 할인 대상: 어떤 상품에 적용하나 (포함 / 제외)
// targetType에 맞는 컬럼 하나만 채웁니다. (ALL이면 전부 비움)
// 범용 targetId 하나 대신 FK 컬럼을 따로 두어서, 없는 카테고리·스타일을 가리키지 못하게 DB가 막아 줍니다.
model PricePromotionTarget {
  id          Int                 @id @default(autoincrement())
  promotionId Int
  targetType  PromotionTargetType
  mode        TargetMode          @default(INCLUDE)

  categoryId Int? // CATEGORY: 이 카테고리와 그 하위 전부
  seasonId   Int? // SEASON
  gender     Gender? // GENDER
  styleId    Int? // STYLE

  // 이 대상에만 다른 할인값 적용 (예: 전체 30%인데 아우터만 40%). 비어 있으면 행사 기본값
  discountValueOverride Int?
  createdAt             DateTime @default(now())

  promotion PricePromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  // 대상이 가리키는 카테고리·시즌·스타일은 삭제 거부. (SetNull이면 "스니커즈 제외" 행이 조용히 무력화되어 제외 상품에 할인이 붙음)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  season    Season?        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  style     Style?         @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@index([promotionId])
  @@index([styleId])
  @@index([categoryId])
}

// ===============================================================
// 재고 도메인 (B안: 주문 시 예약 → 결제 시 확정 → 시간 초과 시 해제)
//
//   InventoryLocation   재고 위치 (온라인 물류센터, 매장, 반품센터, 불량창고)
//   InventoryBalance    SKU × 위치별 "지금 수량" (실재고·예약·안전재고) — 앱이 직접 고치지 않음
//   InventoryLedger     재고 원장 (입고·판매·반품·조정…) — 추가만 가능, 합계 = 실재고
//   InventoryReservation 결제 대기 중인 예약 — RESERVED → CONFIRMED / RELEASED / EXPIRED
//
//   판매 가능 수량 = 실재고(onHand) − 예약(reserved) − 안전재고(safetyStock)
//
// ⚠️ 잔고(onHand, reserved)는 DB 트리거가 원장·예약에서 자동으로 맞춥니다(prisma/db-constraints.ts).
//    앱은 원장 행 추가 / 예약 행 추가·상태 변경만 합니다. 그래서 "원장 합계 = 실재고"가 DB에서 보장됩니다.
// ===============================================================

// 재고 위치 종류
enum LocationType {
  WAREHOUSE // 물류센터 (온라인 출고)
  STORE // 오프라인 매장 (⑲ 단계에서 사용)
  RETURN_CENTER // 반품 검수센터 (검수 전 재고, 판매 불가)
  DEFECT // 불량 창고 (판매 불가)
}

// 원장 유형. 유형마다 수량의 부호가 정해져 있습니다 (CHECK로 강제).
enum LedgerType {
  INITIAL // + 시스템 도입 시 기초 재고
  INBOUND // + 입고 (생산·발주)
  RETURN_IN // + 반품 입고 (고객이 보낸 물건이 반품센터에 도착 — 검수 전이라 판매 불가 위치)
  ADJUST_IN // + 실사 조정 (시스템보다 실물이 많음)
  TRANSFER_IN // + 위치 이동 입고
  SALE // − 판매 출고 확정 (결제 승인 시 예약 확정에서 자동 생성)
  ADJUST_OUT // − 실사 조정 (분실 등, 시스템보다 실물이 적음)
  DEFECT_OUT // − 불량 처리
  TRANSFER_OUT // − 위치 이동 출고
  RETURN_REJECT_OUT // − 반품 불가 상품을 고객에게 다시 보냄 (반품센터에서 나감)
}

// 원장이 무엇 때문에 생겼는지
enum LedgerRefType {
  ORDER // 주문 (refId = 주문 id)
  RETURN // 반품 (⑩ 클레임 단계)
  INBOUND_ORDER // 입고 문서 (발주·생산 오더 번호)
  STOCK_COUNT // 재고 실사
  TRANSFER // 위치 이동 (나가는 행·들어오는 행이 같은 refId)
  MANUAL // 관리자 수동 처리 (사유 필수)
  MIGRATION // 시스템 이전 (Sku.stock → 원장)
}

// 예약 상태 (⑦ 주문: 재고는 "출고할 때" 줄어듭니다)
//   RESERVED ─결제─▶ ALLOCATED ─출고─▶ CONFIRMED (원장 SALE → 실재고 감소)
//      │               └─출고 전 취소(환불 완료 후)─▶ RELEASED (원장 기록 없음: 물건이 창고를 떠난 적 없음)
//      └─결제 안 함─▶ RELEASED / EXPIRED
// RESERVED·ALLOCATED는 판매 가능 수량에서 빠져 있음 (InventoryBalance.reserved = 둘의 합)
enum ReservationStatus {
  RESERVED // 결제 대기 중 (20분 등 기한이 있음)
  ALLOCATED // 결제 완료, 출고 대기 (기한 없음: 만료되지 않음)
  CONFIRMED // 출고 확정 → 원장 SALE 생성 (실재고 감소)
  RELEASED // 해제 (결제 실패·이탈·새 주문으로 대체·출고 전 취소 등)
  EXPIRED // 만료 (RESERVED만 만료됨)
}

// 예약 해제 사유
enum ReleaseReason {
  PAYMENT_FAILED // 결제 실패·결제창 취소
  SUPERSEDED // 같은 고객이 새 주문을 만들어 이전 결제 대기 주문을 대체
  PRICE_CHANGED // 결제 직전 가격 변경으로 중단
  COMPENSATED // 결제 승인 후 저장 실패 → 결제 취소(보상)
  RENEWED // 결제 승인 직전 만료가 임박해서 새 예약으로 갱신 (가상계좌 발급 시 입금 기한까지 연장도 포함)
  ORDER_CANCELED // 입금 전 주문 취소 등 결제가 취소됨
  DEPOSIT_EXPIRED // 가상계좌 입금 기한 만료
  ADMIN // 관리자 처리
}

// 재고 위치
model InventoryLocation {
  id               Int          @id @default(autoincrement())
  code             String       @unique // ONLINE_DC
  name             String // 온라인 물류센터 (이천)
  type             LocationType
  isOnlineSellable Boolean      @default(false) // 온라인 주문에 재고를 쓸 수 있는 위치인가
  isActive         Boolean      @default(true)
  priority         Int          @default(0) // 여러 위치에 재고가 있을 때 먼저 쓰는 순서 (작을수록 먼저)
  address          String?
  contactPhone     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  balances     InventoryBalance[]
  ledgers      InventoryLedger[]
  reservations InventoryReservation[]
  shipments    Shipment[] // 이 위치(창고)에서 나간 출고
  receipts     InboundReceipt[] // 이 위치로 들어온 입고
  stockAlerts  StockAlert[]
}

// 위치별 재고 잔고 ("지금 몇 개")
// 행은 0으로만 만들 수 있고, onHand·reserved는 트리거만 바꿀 수 있습니다.
model InventoryBalance {
  skuId         Int
  locationId    Int
  onHand        Int       @default(0) // 실재고: 창고에 실제로 있는 수량 (= 원장 합계)
  reserved      Int       @default(0) // 예약: 결제 대기 + 결제됐지만 출고 전인 수량 (= RESERVED·ALLOCATED 예약 합계)
  safetyStock   Int       @default(0) // 안전재고: 오차 대비로 팔지 않고 남겨 두는 수량
  lastCountedAt DateTime? // 마지막 실사 일시
  reorderPoint  Int       @default(0) // ★ 재주문점: 판매 가능 수량이 이 값 이하면 "재주문 필요" 알림 (0 = 알림 안 함)
  reorderQty    Int       @default(0) // ★ 재주문 권장 수량 (알림에 함께 표시)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) // 트리거·앱이 갱신

  sku      Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([skuId, locationId])
  @@index([locationId])
}

// 재고 원장: 재고가 바뀐 모든 이유를 한 줄씩 기록 (추가만 가능 — 수정·삭제 금지)
// 실재고 = 이 테이블 qty의 합계. 잘못 넣었으면 지우지 말고 반대 방향 행을 추가합니다.
model InventoryLedger {
  id            Int           @id @default(autoincrement())
  skuId         Int
  locationId    Int
  type          LedgerType
  qty           Int // 변동 수량 (입고 +10, 판매 −1)
  balanceAfter  Int // 반영 후 실재고 (트리거가 "직전 실재고 + qty"와 같은지 검사)
  refType       LedgerRefType
  refId         String? // 참조 번호 (주문 id, 입고 문서 번호 PO-2611-001 등)
  reservationId Int? // SALE이면 어떤 예약이 확정된 것인지
  inboundLineId Int? // ★ 입고 전표 줄 (입고면)
  returnItemId  Int? // ★ 반품 상품 (반품 도착·검수 이동·반송이면)
  reason        String? // 조정·불량·수동 처리 사유 (해당 유형은 필수)
  memo          String?
  createdBy     String? // 처리자 (관리자 단계에서 FK로 연결, 시스템 처리는 SYSTEM)
  occurredAt    DateTime // 실제로 일어난 시각 (실사일, 입고일)
  createdAt     DateTime      @default(now()) // 기록한 시각

  sku         Sku                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location    InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  inboundLine InboundReceiptLine?   @relation(fields: [inboundLineId], references: [id], onDelete: Restrict)
  returnItem  ReturnItem?           @relation(fields: [returnItemId], references: [id], onDelete: Restrict)

  @@index([skuId, locationId, id]) // 잔고 재계산·이력 조회
  @@index([refType, refId])
  @@index([reservationId])
  @@index([inboundLineId])
  @@index([returnItemId])
}

// 재고 예약: 주문을 만들 때 잡고 → 결제되면 할당 → 출고되면 확정 / 아니면 해제·만료
// ⑦ 주문: 주문 상품 줄(OrderItem)과 1:1로 연결 (반품·부분 취소 때 "어느 상품의 재고인지" 알 수 있게)
model InventoryReservation {
  id            Int               @id @default(autoincrement())
  orderId       Int
  orderItemId   Int // ★ 주문 상품 줄 (orderId·skuId·qty가 그 줄과 같아야 함 — 트리거)
  skuId         Int
  locationId    Int
  qty           Int
  status        ReservationStatus @default(RESERVED)
  expiresAt     DateTime // 이 시각까지 결제하지 않으면 만료 (RESERVED일 때만 의미 있음)
  allocatedAt   DateTime? // ★ 결제 완료로 할당된 시각
  confirmedAt   DateTime? // 출고로 확정된 시각 (= 출고 시각)
  shipmentId    Int? // ★ 어느 출고 상자로 나갔는지 (CONFIRMED면 필수)
  releasedAt    DateTime? // 해제·만료된 시각
  releaseReason ReleaseReason? // 해제 사유 (만료는 상태로 구분하므로 비워 둠)
  createdAt     DateTime          @default(now())

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  sku       Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location  InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shipment  Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  ledgers   InventoryLedger[]

  @@index([skuId, locationId, status]) // 예약 합계 계산
  @@index([orderId])
  @@index([orderItemId])
  @@index([shipmentId])
  @@index([status, expiresAt]) // 만료 대상 찾기
}

// ===============================================================
// 고객 도메인 (B안: 로그인 계정 User와 쇼핑몰 고객 Customer 분리)
//
//   User (Auth.js 로그인 계정) ──1:1── Customer (고객번호·상태·등급)
//                                        ├─ CustomerProfile      개인정보 (AES-256-GCM 암호화)
//                                        ├─ CustomerBodyProfile  체형 정보 (선택)
//                                        ├─ CustomerAddress      배송지 N개 (암호화)
//                                        ├─ CustomerStatusHistory 상태 이력 (트리거가 자동 기록)
//                                        ├─ CustomerGradeHistory  등급 이력
//                                        ├─ CustomerWithdrawal    탈퇴 신청·처리
//                                        └─ CustomerLoginHistory  로그인 기록 (3개월 보관)
//
// 탈퇴: 신청 → 7일 유예(철회 가능) → 개인정보 익명화 + User 삭제. Customer와 주문은 남음(전자상거래법 5년 보관).
// 개인정보 암호문 형식: "v1:<IV>:<인증태그>:<암호문>" (base64). 키는 .env의 CUSTOMER_ENC_KEY (lib/crypto.ts)
// ===============================================================

// 고객 상태
enum CustomerStatus {
  ACTIVE // 정상
  DORMANT // 휴면 (1년 미접속. 분리 보관 의무는 2023.9 폐지 → 상태 표시만)
  SUSPENDED // 이용 정지 (부정 이용)
  WITHDRAW_PENDING // 탈퇴 신청 (7일 유예, 철회 가능)
  WITHDRAWN // 탈퇴 완료 (익명화, 되돌릴 수 없음)
}

// 상태 변경 사유 (이력에 남음)
enum CustomerStatusReason {
  SIGNUP // 가입
  LOGIN // 휴면 고객이 다시 로그인
  INACTIVITY // 장기 미접속으로 휴면 전환
  ABUSE // 부정 이용으로 정지
  APPEAL // 정지 해제
  WITHDRAW_REQUEST // 탈퇴 신청
  WITHDRAW_CANCEL // 탈퇴 철회
  WITHDRAW_COMPLETE // 탈퇴 완료
  ADMIN // 관리자 처리
}

// 가입 경로
enum JoinChannel {
  WEB
  APP
  STORE // 매장 가입 (로그인 계정이 없을 수 있음)
  IMPORT // 데이터 이전
}

// 고객 성별 (상품의 Gender와 별개: 고객은 밝히지 않을 수 있음)
enum CustomerGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

// 탈퇴 사유
enum WithdrawalReason {
  LOW_USAGE // 이용 빈도 낮음
  PRIVACY // 개인정보 우려
  PRODUCT // 상품 불만
  DELIVERY // 배송 불만
  SERVICE // 서비스·응대 불만
  REJOIN // 재가입 목적
  OTHER
}

// 등급 변경 사유
enum GradeChangeReason {
  SIGNUP // 가입 시 기본 등급
  PERIODIC // 정기 산정 (최근 12개월 구매 금액)
  ADMIN // 관리자 조정
}

// 로그인 결과
enum LoginResult {
  SUCCESS
  BLOCKED_SUSPENDED // 정지 회원 차단
}

// 쇼핑몰 고객
model Customer {
  id          Int            @id @default(autoincrement())
  customerNo  String         @unique // C + 숫자 10자리 (외부 노출용. 순번이 아니라 무작위 → 다른 고객 번호 추측 방지)
  userId      String?        @unique // 로그인 계정. 탈퇴하면 비움. 매장 가입 고객은 없을 수 있음
  status      CustomerStatus @default(ACTIVE)
  gradeId     Int // 현재 등급 (바꾸려면 등급 이력을 먼저 추가)
  joinChannel JoinChannel    @default(WEB)
  joinedAt    DateTime       @default(now())
  lastLoginAt DateTime?
  lastOrderAt DateTime? // 마지막 결제 완료 시각 (휴면·등급 산정 참고)

  // 상태 변경 정보: 상태를 바꿀 때 함께 바꾸고, 트리거가 이 값으로 상태 이력을 남깁니다.
  statusReason    CustomerStatusReason
  statusMemo      String?
  statusChangedBy String? // 처리자 (SYSTEM / 관리자)
  statusChangedAt DateTime

  dormantAt       DateTime? // 휴면 전환 시각
  suspendedAt     DateTime? // 정지 시각
  suspendedReason String?
  withdrawnAt     DateTime? // 탈퇴 완료 시각
  anonymizedAt    DateTime? // 개인정보 익명화 시각

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  grade                CustomerGrade           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  profile              CustomerProfile?
  bodyProfile          CustomerBodyProfile?
  addresses            CustomerAddress[]
  statusHistory        CustomerStatusHistory[]
  gradeHistory         CustomerGradeHistory[]
  withdrawals          CustomerWithdrawal[]
  loginHistory         CustomerLoginHistory[]
  orders               Order[]
  claimedGuestOrders   GuestOrderAccess[] // 비회원 때 주문했다가 가져온 주문
  restockSubscriptions RestockSubscription[] // 재입고 알림 신청
  notifications        Notification[] // 받은 알림 (알림함)
  guestAttempts        GuestLookupAttempt[] // 비회원 주문 가져오기 시도
  coupons              CustomerCoupon[] // 받은 쿠폰 (쿠폰함)
  couponCodeAttempts   CouponCodeAttempt[] // 쿠폰 코드 입력 시도

  @@index([status])
  @@index([gradeId])
  @@index([lastLoginAt]) // 휴면 대상 찾기
}

// 개인정보 (1:1, 암호화). 화면에는 마스킹해서 보여 줍니다 (홍*동, 010-****-5678)
model CustomerProfile {
  customerId      Int            @id
  nameEnc         String? // 이름 암호문
  phoneEnc        String? // 휴대폰 암호문
  phoneHash       String? // 휴대폰 검색용 HMAC (블라인드 인덱스). 중복 가입 확인·전화번호로 찾기
  birthDateEnc    String? // 생년월일 암호문 (YYYY-MM-DD)
  birthMonth      Int? // 생일 월 (생일 쿠폰용, 평문. 월만으로는 개인 식별 불가)
  gender          CustomerGender @default(UNDISCLOSED)
  contactEmailEnc String? // 연락용 이메일 암호문 (로그인 이메일과 다를 수 있음)
  emailHash       String? // 연락용 이메일 검색용 HMAC
  updatedAt       DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([phoneHash])
  @@index([emailHash])
}

// 체형 정보 (1:1, 모두 선택). 사이즈 추천·리뷰의 "구매자 체형"에 사용
model CustomerBodyProfile {
  customerId    Int      @id
  heightCm      Int?
  weightKg      Int?
  topSize       String? // 평소 상의 사이즈 (95, M ...)
  bottomSize    String? // 평소 하의 사이즈 (30 ...)
  shoeSizeMm    Int? // 평소 신발 사이즈 (270)
  preferredFit  Fit? // 선호 핏
  showInReviews Boolean  @default(false) // 리뷰에 체형 공개 동의 (기본 비공개)
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
}

// 배송지 (N개, 암호화). 주문에는 배송지 "스냅샷"을 복사하므로 주소록은 지워도 됨 (⑦ 주문 단계)
model CustomerAddress {
  id              Int       @id @default(autoincrement())
  customerId      Int
  label           String // 집 / 회사
  recipientEnc    String // 수령인 암호문
  phoneEnc        String // 수령인 연락처 암호문
  zipCode         String // 우편번호 5자리 (평문: 단독으로는 개인 식별 불가, 배송비 산정에 사용)
  address1Enc     String // 기본 주소 암호문
  address2Enc     String? // 상세 주소 암호문
  deliveryMemoEnc String? // ★ 배송 요청 사항 암호문 (⑦: "공동현관 비밀번호 1234#"처럼 민감한 내용이 자주 들어가서 평문 → 암호화)
  isDefault       Boolean   @default(false) // 기본 배송지 (고객당 최대 1개, 트리거)
  lastUsedAt      DateTime? // 마지막으로 주문에 쓴 시각 (주문서에서 최근 사용 순 정렬)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderAddresses OrderShippingAddress[] // 이 주소록에서 복사된 주문 배송지 (주소록을 지우면 연결만 비움)

  @@index([customerId])
}

// 상태 변경 이력 (추가만 가능). Customer의 상태가 바뀌면 트리거가 자동으로 한 줄 추가
model CustomerStatusHistory {
  id         Int                  @id @default(autoincrement())
  customerId Int
  fromStatus CustomerStatus? // 가입 시 비어 있음
  toStatus   CustomerStatus
  reason     CustomerStatusReason
  memo       String?
  changedBy  String?
  changedAt  DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, id])
}

// 탈퇴 신청·처리
model CustomerWithdrawal {
  id               Int              @id @default(autoincrement())
  customerId       Int
  reasonCode       WithdrawalReason
  reasonText       String? // 직접 입력한 사유
  requestedAt      DateTime
  scheduledAt      DateTime // 처리 예정일 (신청 + 7일 이상). 이전에는 철회 가능
  completedAt      DateTime? // 처리 완료 (익명화)
  canceledAt       DateTime? // 철회
  rejoinBlockHash  String? // 재가입 악용 방지: 로그인 계정(제공자+계정ID)의 HMAC. 개인정보 아님
  rejoinBlockUntil DateTime? // 이 시각까지 같은 계정 재가입 제한 (완료 + 30일)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([rejoinBlockHash])
  @@index([scheduledAt]) // 처리 대상 찾기
}

// 회원 등급 마스터
model CustomerGrade {
  id          Int      @id @default(autoincrement())
  code        String   @unique // WELCOME / SILVER / GOLD / VIP
  name        String
  minAmount   Int      @unique // 최근 12개월 결제 금액 기준 (원). 기준이 겹치지 않게 UNIQUE
  pointRateBp Int // 포인트 적립률 (bp: 100 = 1%). ⑭ 포인트 단계에서 사용
  sortOrder   Int      @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers   Customer[]
  historyFrom CustomerGradeHistory[] @relation("GradeFrom")
  historyTo   CustomerGradeHistory[] @relation("GradeTo")
  couponPolicies CouponPolicyGrade[] // 이 등급이 받을 수 있는 쿠폰
}

// 등급 변경 이력 (추가만 가능)
model CustomerGradeHistory {
  id             Int               @id @default(autoincrement())
  customerId     Int
  fromGradeId    Int? // 가입 시 비어 있음
  toGradeId      Int
  reason         GradeChangeReason
  purchaseAmount Int? // 산정에 쓴 결제 금액
  periodFrom     DateTime? // 산정 기간
  periodTo       DateTime?
  changedBy      String?
  changedAt      DateTime

  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fromGrade CustomerGrade? @relation("GradeFrom", fields: [fromGradeId], references: [id], onDelete: Restrict)
  toGrade   CustomerGrade  @relation("GradeTo", fields: [toGradeId], references: [id], onDelete: Restrict)

  @@index([customerId, id])
}

// 로그인 기록 (통신비밀보호법 접속기록 3개월 보관). 수정 금지, 3개월 지난 것만 삭제 가능
model CustomerLoginHistory {
  id         Int         @id @default(autoincrement())
  customerId Int
  provider   String // github
  result     LoginResult
  ipMasked   String? // 123.45.67.*  (마지막 자리 가림)
  userAgent  String?
  loggedInAt DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, loggedInAt])
  @@index([loggedInAt]) // 3개월 지난 기록 정리
}

// ===============================================================
// 주문 도메인 (⑦ B안: 주문 + 상품별 상태 + 출고 분리)
//
//   Customer 1 ──< Order ─── 1 OrderShippingAddress ──< OrderShippingAddressHistory
//                   │  │            (배송지 스냅샷·암호화)         (변경 전 주소)
//                   │  ├──< OrderStatusHistory          주문(돈) 상태 이력 — 트리거 기록
//                   │  ├──< Payment …                   결제 도메인 (기존)
//                   │  ├──> ShippingPolicy ──< ShippingSurchargeZone   배송비 규칙·제주/도서산간
//                   │  └──< Shipment ──< ShipmentItem >── OrderItem    출고 상자·송장
//                   │          ├──> Courier            택배사
//                   │          └──> InventoryLocation  출고 창고 (기존)
//                   └──< OrderItem ──< OrderItemStatusHistory          상품(물건) 상태 이력
//                          ├──> Sku / PricePromotion (기존)
//                          └──< InventoryReservation (기존, 1:1로 연결)
//
// 상태 두 가지를 섞지 않습니다:
//   Order.status      = 돈의 상태  (결제대기·입금대기·결제완료·취소·만료·취소실패) ← 결제 도메인이 바꿈
//   OrderItem.status  = 물건의 상태 (결제대기 → 결제완료 → 상품준비중 → 배송중 → 배송완료 → 구매확정 / 취소)
//   Order.fulfillmentStatus = 상품 상태들의 요약 (목록·검색용, 트리거가 계산)
//
// 금액: 결제액 = 상품 판매가 합계 − 쿠폰 + 배송비 − 배송비 할인 − 포인트  (CHECK)
//       상품별 실결제액(payAmount)의 합 = 상품 판매가 합계 − 쿠폰 − 포인트 (결제 시작 때 트리거가 검사)
// 재고: 결제 → 할당(ALLOCATED), 출고 → 확정(CONFIRMED, 실재고 감소), 출고 전 취소 → 해제
// 보관: 주문·주문 상품은 삭제 불가. 주문자·배송지 개인정보는 5년 뒤 파기 (piiPurgedAt)
// ===============================================================

// 주문 상태 = 돈의 상태 (결제 도메인)
enum OrderStatus {
  PENDING // 결제 대기 (주문서에서 결제하기를 눌렀고 아직 결제 전)
  WAITING_DEPOSIT // 입금 대기 (가상계좌 발급됨)
  PAID // 결제 완료
  CANCELED // 취소 (결제 전 취소, 입금 전 취소, 출고 전 전액 취소, 보상 취소)
  EXPIRED // 입금 기한 만료
  CANCEL_FAILED // 결제 취소(환불) 실패 → 사람이 확인 필요
}

// 주문 상품 상태 = 물건의 상태 (⑩ 클레임에서 반품·교환 상태 추가 예정)
enum OrderItemStatus {
  AWAITING_PAYMENT // 결제 대기 (입금 대기 포함)
  PAID // 결제 완료 (출고 준비 전 — 고객이 바로 취소 가능)
  PREPARING // 상품 준비중 (포장 중일 수 있어 고객 직접 취소 불가)
  SHIPPED // 배송중 (출고됨 — 취소 불가, 반품으로)
  DELIVERED // 배송 완료
  CONFIRMED // 구매 확정 (끝. 이후 포인트 적립·리뷰 작성 기준. 반품 불가)
  CANCELED // 취소 (결제 전 이탈, 출고 전 취소)
  RETURN_REQUESTED // 반품 요청 (배송 완료 후 기간 안. 자동 구매확정 멈춤)
  RETURN_COLLECTING // 반품 회수중 (회수 송장 등록 ~ 검수 전)
  RETURNED // 반품 완료 (검수 통과 → 환불 대상)
}

// 주문 전체 진행 요약 (상품 상태들로 트리거가 계산. 취소된 상품은 빼고 판단)
enum FulfillmentStatus {
  UNPAID // 결제 전
  PAID // 결제 완료, 준비 전
  PREPARING // 상품 준비중 (하나라도)
  PARTIALLY_SHIPPED // 일부만 출고
  SHIPPED // 전부 출고 (배송중 포함)
  DELIVERED // 전부 배송 완료
  CONFIRMED // 전부 구매 확정
  CANCELED // 전부 취소
  RETURNED // 남은 상품 없이 반품(일부 취소 포함)으로 끝남
}

// 상태를 바꾼 주체 (이력에 기록)
enum OrderActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

// 주문자 신분 (주문할 때 기준)
enum OrdererType {
  MEMBER // 회원 (로그인)
  GUEST // 비회원 (주문번호 + 주문 비밀번호로 조회)
}

// 비회원 임시 출입증 용도
enum GuestSessionPurpose {
  CHECKOUT // 주문서 → 결제창 → 완료 화면까지 (같은 브라우저가 주문한 사람임을 확인)
  LOOKUP // 주문번호 + 비밀번호 조회에 성공한 뒤
}

enum GuestAttemptPurpose {
  LOOKUP // 비회원 주문 조회
  CLAIM // 회원이 비회원 주문을 내 계정으로 가져오기
}

enum GuestAttemptResult {
  SUCCESS
  WRONG // 주문번호가 없거나 비밀번호가 틀림 (같은 결과로 취급 — 주문번호 존재 여부를 알려 주지 않음)
  LOCKED // 그 주문이 연속 실패로 잠김
  RATE_LIMITED // 같은 IP의 실패가 너무 많음
  CLAIMED_ALREADY // 이미 회원 계정으로 옮겨진 주문 (비밀번호가 맞을 때만 알려 줌)
}

enum OrderChannel {
  WEB // PC 웹
  MOBILE_WEB // 모바일 웹
}

enum ConfirmType {
  MANUAL // 고객이 구매확정 버튼을 누름
  AUTO // 배송 완료 7일 뒤 자동
}

// 배송 지역 (배송비 계산)
enum ShippingRegion {
  NORMAL // 일반
  JEJU // 제주
  REMOTE // 도서산간
}

// 출고 상자 종류 (⑩ 클레임 값은 미리 정의, 지금은 OUTBOUND만 허용 — 트리거)
enum ShipmentType {
  OUTBOUND // 주문 출고
  RETURN_PICKUP // 반품 회수 (⑩)
  EXCHANGE_OUTBOUND // 교환 재출고 (⑩)
}

enum ShipmentStatus {
  READY // 송장 등록 (아직 택배사에 넘기기 전)
  SHIPPED // 출고 (택배사 인계 → 배송중)
  DELIVERED // 배송 완료
  CANCELED // 송장 취소 (출고 전에만)
}

model Order {
  id             Int          @id @default(autoincrement()) // 내부 번호 (화면·주소에 노출하지 않음)
  orderNo        String       @unique // ★ 고객용 주문번호 "20261118-48213907" (한국 날짜 + 무작위 8자리: 하루 주문 수 노출 방지)
  paymentOrderId String       @unique // 토스페이먼츠에 보내는 주문번호 (영문/숫자/-_= 6~64자)
  orderName      String // 결제창에 보이는 이름. 예: "러닝 스니커즈 외 2건"
  customerId     Int? // 주문한 회원 (로그인 계정 User가 아니라 Customer → 탈퇴해도 남음). 비회원 주문은 비어 있고, 회원 계정으로 가져오면 그 회원
  ordererType    OrdererType // ★ 주문할 "때"의 신분 MEMBER / GUEST (가져와도 바뀌지 않음: 비회원으로 산 사실)
  linkedAt       DateTime? // ★ 비회원 주문을 회원 계정으로 가져온 시각
  channel        OrderChannel @default(WEB) // ★ 주문 경로

  // 상태 (돈). 바꿀 때 statusChangedAt·statusChangedBy를 함께 바꾸면 트리거가 이력을 남김
  status            OrderStatus       @default(PENDING)
  statusChangedAt   DateTime // ★
  statusChangedBy   OrderActor        @default(SYSTEM) // ★
  statusMemo        String? // ★ 상태 변경 사유 (취소 사유 등)
  fulfillmentStatus FulfillmentStatus @default(UNPAID) // ★ 상품 상태 요약 (트리거만 바꿈)

  // 금액 (원, 전부 만든 뒤 바꿀 수 없음)
  itemsListTotal        Int // ★ 정가 합계
  itemsDiscountTotal    Int // ★ 상품 할인 합계 (할인 행사)
  itemsTotal            Int // ★ 판매가 합계 = 정가 합계 − 상품 할인
  couponDiscountTotal   Int  @default(0) // ★ 쿠폰 할인 (⑬ 쿠폰)
  shippingBaseFee       Int // ★ 기본 배송비 (무료배송이면 0)
  shippingExtraFee      Int  @default(0) // ★ 제주·도서산간 추가 배송비 (무료배송이어도 붙음)
  shippingFee           Int // ★ 배송비 합계 = 기본 + 추가
  shippingDiscount      Int  @default(0) // ★ 배송비 할인 (⑬ 무료배송 쿠폰)
  pointUsed             Int  @default(0) // ★ 포인트 사용 (⑭ 포인트)
  totalPrice            Int // 최종 결제액 = 판매가 합계 − 쿠폰 + 배송비 − 배송비 할인 − 포인트 (= Payment.amount)
  shippingPolicyId      Int // ★ 적용한 배송비 규칙
  freeShippingThreshold Int? // ★ 주문 당시 무료배송 기준 (스냅샷, 쿠폰 적용 전 판매가 합계 기준. null = 무료배송 없음)

  // 주문자 스냅샷 (암호문 "v1:…"). 탈퇴해 프로필이 지워져도 주문 기록에는 남음. 프로필에 없으면 비어 있음
  ordererNameEnc   String? // ★
  ordererPhoneEnc  String? // ★
  ordererPhoneHash String? // ★ 고객센터 전화번호 조회용 (HMAC)
  ordererEmailEnc  String? // ★

  paidAt      DateTime? // 결제 완료 시각 (가상계좌는 입금 시각)
  canceledAt  DateTime? // 취소·만료 시각
  confirmedAt DateTime? // ★ 모든 상품 구매확정 시각
  piiPurgedAt DateTime? // ★ 개인정보(주문자·배송지) 파기 시각 (주문 5년 뒤)
  returnedAt  DateTime? // ★ 마지막 반품 완료 시각
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) // 앱이 갱신 (트리거가 바꾸는 요약 칸도 있어 @updatedAt 대신 직접)

  customer        Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  guestAccess     GuestOrderAccess? // 비회원 주문의 조회 비밀번호·동의·가져오기 기록
  guestSessions   GuestOrderSession[]
  guestAttempts   GuestLookupAttempt[]
  returns         ReturnRequest[]
  shippingPolicy  ShippingPolicy         @relation(fields: [shippingPolicyId], references: [id], onDelete: Restrict)
  shippingAddress OrderShippingAddress?
  items           OrderItem[]
  reservations    InventoryReservation[]
  payments        Payment[]
  apiLogs         PaymentApiLog[]
  shipments       Shipment[]
  statusHistory   OrderStatusHistory[]
  coupons         OrderCoupon[] // 이 주문에 쓴 쿠폰

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([fulfillmentStatus, createdAt]) // 관리: "준비 전 주문" 목록
  @@index([ordererPhoneHash])
  @@index([createdAt]) // 5년 지난 개인정보 파기 대상
}

// 비회원 주문의 조회 비밀번호·개인정보 동의·회원 가져오기 기록 (비회원 주문당 1개)
// 비밀번호는 scrypt 해시만 저장 ("s1:<소금값>:<해시>"), 5번 틀리면 30분 잠금
// 회원이 가져가면 claimedAt·claimedByCustomerId 기록 → 비회원 조회로는 "회원 계정으로 옮겨졌어요" 안내만 (비밀번호가 맞을 때)
model GuestOrderAccess {
  orderId               Int       @id
  passwordHash          String? // 5년 뒤 개인정보 파기 때 비움
  failedCount           Int       @default(0) // 연속 실패 (성공하면 0)
  lockedUntil           DateTime? // 연속 5회 실패 → 30분 잠금
  lastFailedAt          DateTime?
  lastAccessAt          DateTime? // 마지막 조회 성공
  privacyConsentAt      DateTime // 비회원 주문 개인정보 수집·이용 동의 시각 (필수)
  privacyConsentVersion String // 동의 문구 버전 (예: guest-order-2611)
  claimedAt             DateTime? // 회원 계정으로 옮긴 시각
  claimedByCustomerId   Int? // 옮겨 간 회원
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  claimedBy Customer? @relation(fields: [claimedByCustomerId], references: [id], onDelete: Restrict)

  @@index([claimedByCustomerId])
}

// 비회원 임시 출입증 (쿠키에는 무작위 값, DB에는 SHA-256 해시만). 30분, 회원으로 가져가면 모두 무효
model GuestOrderSession {
  id        Int                 @id @default(autoincrement())
  orderId   Int
  tokenHash String              @unique
  purpose   GuestSessionPurpose
  expiresAt DateTime
  revokedAt DateTime?
  ipMasked  String?
  createdAt DateTime            @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([expiresAt]) // 지난 출입증 정리
}

// 비회원 조회·가져오기 시도 기록 (무작위 대입 차단 + 감사, 추가만 가능, 90일 보관)
model GuestLookupAttempt {
  id           Int                 @id @default(autoincrement())
  purpose      GuestAttemptPurpose
  orderNoInput String // 입력한 주문번호 (형식이 틀리면 'INVALID')
  orderId      Int? // 실제로 있는 주문이면
  customerId   Int? // 가져오기를 시도한 회원
  result       GuestAttemptResult
  ipHash       String // 같은 IP 실패 횟수 세기용 (HMAC, 원문 IP 저장 안 함)
  ipMasked     String? // 사람이 보는 용도 (가린 IP)
  attemptedAt  DateTime

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([ipHash, attemptedAt]) // IP별 최근 실패
  @@index([orderId, attemptedAt])
  @@index([attemptedAt]) // 90일 지난 기록 정리
}

// 주문 당시 배송지 (주문당 1개, 암호화). 주소록(CustomerAddress)을 바꾸거나 지워도 이 값은 그대로
// 변경: 모든 상품이 "상품 준비중"이 되기 전까지만, 배송비가 달라지는 지역으로는 불가 (트리거)
model OrderShippingAddress {
  id              Int            @id @default(autoincrement())
  orderId         Int            @unique
  sourceAddressId Int? // 복사해 온 주소록 (주소록을 지우면 비움)
  recipientEnc    String? // 받는 분 (파기 후 null)
  phoneEnc        String? // 연락처
  phoneHash       String? // 연락처 조회용 HMAC
  zipCode         String // 우편번호 5자리 (평문: 배송비 지역 판단·통계, 파기 후에도 남김)
  address1Enc     String? // 기본 주소
  address2Enc     String? // 상세 주소
  deliveryMemoEnc String? // 배송 요청 사항 (공동현관 비밀번호 등 → 암호화)
  region          ShippingRegion // 배송 지역 (zipCode로 계산, 변경해도 같아야 함)
  version         Int            @default(1) // 바꿀 때마다 +1 (트리거가 이전 값을 이력에 저장)
  changedBy       OrderActor? // 마지막으로 바꾼 주체 (처음 저장 시 null)
  changeReason    String?
  piiPurgedAt     DateTime? // 개인정보 파기 시각 (파기하면 암호문 칸이 전부 null)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order         Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceAddress CustomerAddress?              @relation(fields: [sourceAddressId], references: [id], onDelete: SetNull)
  history       OrderShippingAddressHistory[]

  @@index([sourceAddressId])
  @@index([phoneHash])
}

// 배송지 변경 이력 (추가만 가능, 트리거가 기록). 변경 "전" 값을 저장
model OrderShippingAddressHistory {
  id                     Int            @id @default(autoincrement())
  orderShippingAddressId Int
  version                Int // 이 값이 쓰이던 버전
  recipientEnc           String?
  phoneEnc               String?
  zipCode                String
  address1Enc            String?
  address2Enc            String?
  deliveryMemoEnc        String?
  region                 ShippingRegion
  changedBy              OrderActor // 이 값을 다음 버전으로 바꾼 주체
  changeReason           String?
  changedAt              DateTime

  address OrderShippingAddress @relation(fields: [orderShippingAddressId], references: [id], onDelete: Restrict)

  @@unique([orderShippingAddressId, version])
}

// 주문(돈) 상태 이력 (추가만 가능, 트리거가 기록)
model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int
  fromStatus OrderStatus? // 처음 생성은 null
  toStatus   OrderStatus
  changedBy  OrderActor
  memo       String?
  changedAt  DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, id])
}

// 주문 상품(물건) 상태 이력 (추가만 가능, 트리거가 기록)
model OrderItemStatusHistory {
  id          Int              @id @default(autoincrement())
  orderItemId Int
  fromStatus  OrderItemStatus?
  toStatus    OrderItemStatus
  changedBy   OrderActor
  memo        String?
  changedAt   DateTime

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId, id])
}

// 배송비 규칙 (기간별 버전. 기간이 겹치면 안 됨 — 트리거). 주문에 쓰인 규칙은 금액을 바꿀 수 없음
model ShippingPolicy {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique // STD-2611 / LEGACY-FREE
  name                  String // "기본 배송비 3,000원 / 5만원 이상 무료"
  baseFee               Int // 기본 배송비
  freeShippingThreshold Int? // 이 금액 이상이면 기본 배송비 무료 (쿠폰 적용 전 판매가 합계 기준, null = 없음)
  validFrom             DateTime
  validTo               DateTime? // null = 현재 적용 중
  memo                  String?
  createdAt             DateTime  @default(now())

  zones  ShippingSurchargeZone[]
  orders Order[]

  @@index([validFrom])
}

// 제주·도서산간 추가 배송비 (우편번호 범위, 규칙마다. 같은 규칙 안에서 범위가 겹치면 안 됨 — 트리거)
model ShippingSurchargeZone {
  id        Int            @id @default(autoincrement())
  policyId  Int
  region    ShippingRegion // JEJU / REMOTE (NORMAL 불가)
  name      String // "제주 전역", "울릉군"
  zipFrom   String // 우편번호 시작 (5자리, 포함)
  zipTo     String // 우편번호 끝 (5자리, 포함)
  extraFee  Int // 추가 배송비
  createdAt DateTime       @default(now())

  policy ShippingPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId, zipFrom])
}

// 택배사
model Courier {
  id                  Int      @id @default(autoincrement())
  code                String   @unique // CJ / LOTTE / HANJIN / EPOST / LOGEN
  name                String // CJ대한통운
  trackingUrlTemplate String // 배송조회 주소, 송장 자리는 {no}
  trackingNoMinLength Int // 송장번호 자릿수 (숫자만)
  trackingNoMaxLength Int
  isActive            Boolean  @default(true)
  sortOrder           Int      @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shipments     Shipment[]
  returnPickups ReturnRequest[] // 반품 회수 택배사
}

// 출고 상자 1개 = 송장 1개. 한 주문을 여러 상자로 나눠 보낼 수 있음 (부분 출고)
// 상자 상태가 바뀌면 트리거가 안의 상품 상태와 재고 예약을 함께 바꿈 (SHIPPED → 상품 배송중 + 재고 확정)
model Shipment {
  id              Int            @id @default(autoincrement())
  orderId         Int
  type            ShipmentType   @default(OUTBOUND)
  status          ShipmentStatus @default(READY)
  locationId      Int // 출고 창고
  courierId       Int
  trackingNo      String // 송장번호 (숫자만, 택배사 자릿수 — 트리거)
  statusChangedAt DateTime
  shippedAt       DateTime? // 택배사 인계 시각
  deliveredAt     DateTime? // 배송 완료 시각
  canceledAt      DateTime?
  createdBy       String // 처리자 (관리자 단계에서 FK, 지금은 "ADMIN:<이름>" / SYSTEM)
  memo            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  location     InventoryLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  courier      Courier                @relation(fields: [courierId], references: [id], onDelete: Restrict)
  items        ShipmentItem[]
  reservations InventoryReservation[]

  @@unique([courierId, trackingNo])
  @@index([orderId])
  @@index([status, shippedAt]) // 배송 완료 확인 대상
}

// 상자에 담긴 상품 (상품 줄 단위. 한 줄은 살아 있는 출고 상자 하나에만)
model ShipmentItem {
  id          Int @id @default(autoincrement())
  shipmentId  Int
  orderItemId Int
  qty         Int // 지금은 상품 줄 수량 전체 (= OrderItem.quantity)

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

// ===============================================================
// 결제 도메인 (B안: 결제 시도마다 1행 + 수단별 상세 + 취소 + 이력 + API 기록 + 웹훅)
//
//   Order 1 ──< Payment (시도마다 1행. 한 주문에 "진행 중·완료" 결제는 1개만 — 트리거)
//                 ├─ PaymentCard / PaymentEasyPay / PaymentVirtualAccount  수단별 상세 (1:1)
//                 ├─< PaymentCancel        부분·전체 취소 (취소 금액·잔액·상태는 트리거가 계산)
//                 ├─< PaymentRefundAccount 가상계좌 환불 계좌 (암호화, 환불 후 파기)
//                 ├─< PaymentStatusHistory 상태 이력 (트리거가 자동 기록)
//                 └─< CashReceipt          현금영수증
//   PaymentApiLog        토스 API 호출 기록 (민감정보 가림, 1년 보관)
//   PaymentWebhookEvent  토스가 보낸 알림 원문 (중복 제거, 처리 상태)
//
// 원칙: ① 돈에 관한 사실(토스 승인)을 먼저 저장하고, 그다음 주문·재고를 확정합니다.
//       ② 토스 응답을 못 받으면 실패로 단정하지 않고 UNKNOWN으로 두고 토스에 다시 물어봅니다.
//       ③ 웹훅 내용은 그대로 믿지 않고, 토스 조회 API로 다시 확인한 값만 반영합니다.
// ===============================================================

enum PaymentProvider {
  TOSS
}

// 토스 method 값(한글)을 코드로 바꿔 저장 (lib/payment.ts)
enum PaymentMethod {
  CARD // 카드
  VIRTUAL_ACCOUNT // 가상계좌
  EASY_PAY // 간편결제
  TRANSFER // 계좌이체
  MOBILE_PHONE // 휴대폰
  GIFT_CERTIFICATE // 상품권 (문화·도서·게임)
}

enum PaymentStatus {
  IN_PROGRESS // 우리가 토스에 승인을 요청하는 중 (이 행을 먼저 만든 요청만 토스를 호출 → 동시 승인 방지)
  UNKNOWN // 승인 요청의 응답을 못 받음 (시간 초과·네트워크) → 토스 조회로 확정해야 함
  WAITING_FOR_DEPOSIT // 가상계좌 입금 대기
  DONE // 결제 완료
  PARTIAL_CANCELED // 부분 취소
  CANCELED // 전액 취소
  ABORTED // 실패 (카드 거절, 결제창 취소, 재고 소진 등)
  EXPIRED // 만료 (가상계좌 입금 기한 초과, 승인 시간 초과)
}

// 상태를 바꾼 경로 (이력에 남김)
enum PaymentStatusSource {
  CONFIRM // 결제 승인 처리 (successUrl)
  WINDOW // 결제창에서 실패·취소 (failUrl)
  RECONCILE // 정기 대사 작업 (토스 조회)
  WEBHOOK // 토스 웹훅
  CANCEL // 결제 취소 (트리거가 자동으로)
  SYSTEM // 그 밖의 시스템 처리
  MIGRATION // 기존 데이터 이전
}

enum CardType {
  CREDIT // 신용
  CHECK // 체크
  GIFT // 기프트
  UNKNOWN // 미확인
}

enum CardOwnerType {
  PERSONAL // 개인
  CORPORATE // 법인
  UNKNOWN // 미확인
}

enum VirtualAccountType {
  NORMAL // 일반 (결제마다 발급)
  FIXED // 고정
}

enum PaymentCancelStatus {
  REQUESTED // 토스에 취소 요청 중
  DONE // 취소 완료
  FAILED // 취소 실패 (토스가 거절)
  UNKNOWN // 응답을 못 받음 → 같은 멱등키로 다시 요청해 확정
}

enum PaymentCancelReason {
  CUSTOMER_REQUEST // 고객 요청 (입금 전 취소, 결제 취소)
  ORDER_ERROR // 결제 승인 후 주문 처리 실패 → 자동 취소(보상)
  OUT_OF_STOCK // 입금됐지만 재고가 없어 취소
  ADMIN // 관리자 처리
  PG_SYNC // 토스 쪽에서 취소된 것을 우리 DB에 반영 (상점관리자 화면 취소 등)
}

enum PaymentActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum PaymentApiOperation {
  CONFIRM // POST /v1/payments/confirm
  CANCEL // POST /v1/payments/{paymentKey}/cancel
  GET_PAYMENT // GET /v1/payments/{paymentKey}
}

enum PaymentApiOutcome {
  SUCCESS
  FAIL // 토스가 오류 코드로 응답 (결과가 확실함)
  TIMEOUT // 시간 초과 (결과 모름)
  NETWORK_ERROR // 연결 실패 등 (결과 모름)
}

enum WebhookEventStatus {
  RECEIVED // 저장만 함
  PROCESSED // 반영 완료
  IGNORED // 우리 결제가 아니거나 반영할 것이 없음
  FAILED // 처리 중 오류 → 정기 작업이 다시 시도
}

enum CashReceiptType {
  INCOME_DEDUCTION // 소득공제
  EXPENSE_PROOF // 지출증빙
}

enum CashReceiptStatus {
  ISSUED
  CANCELED
}

// 결제 시도 1회 = 1행
model Payment {
  id                    Int                 @id @default(autoincrement())
  orderId               Int
  attemptNo             Int // 같은 주문의 몇 번째 시도인지 (1부터, 트리거가 검사)
  provider              PaymentProvider     @default(TOSS)
  pgOrderId             String // 토스에 보낸 주문번호 (= Order.paymentOrderId)
  paymentKey            String?             @unique // 토스 결제 키 (결제창 단계에서 실패하면 없음)
  method                PaymentMethod?
  status                PaymentStatus
  amount                Int // 결제 요청 금액 (= 주문 금액, 트리거가 검사)
  canceledAmount        Int                 @default(0) // 취소된 금액 합계 (트리거가 계산)
  balanceAmount         Int // 취소 가능한 남은 금액 = amount − canceledAmount (트리거가 계산)
  suppliedAmount        Int? // 공급가액
  vat                   Int? // 부가세
  taxFreeAmount         Int                 @default(0) // 면세 금액
  currency              String              @default("KRW")
  isPartialCancelable   Boolean? // 부분 취소 가능 여부 (토스가 알려 줌)
  transferBankCode      String? // 계좌이체(퀵계좌이체 포함)로 결제한 은행 코드 (영수증·주문 내역 표시용)
  confirmIdempotencyKey String?             @unique // 승인 요청 멱등키: 다시 요청해도 두 번 승인되지 않음 (15일 유효)
  secretHash            String? // 웹훅 검증용 secret의 HMAC (원문은 저장하지 않음)
  receiptUrl            String? // 영수증 주소
  lastTransactionKey    String?
  failCode              String? // 실패 코드 (토스 코드 또는 우리 코드 OUT_OF_STOCK 등)
  failMessage           String?
  requestedAt           DateTime? // 토스 결제 요청 시각
  approvedAt            DateTime? // 승인 시각
  failedAt              DateTime?
  canceledAt            DateTime? // 전액 취소 시각
  expiredAt             DateTime?
  syncedAt              DateTime? // 토스 정보와 마지막으로 맞춘 시각
  statusSource          PaymentStatusSource // 상태를 바꾼 경로 (이력에 기록)
  statusChangedAt       DateTime
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  card           PaymentCard?
  easyPay        PaymentEasyPay?
  virtualAccount PaymentVirtualAccount?
  cancels        PaymentCancel[]
  refundAccounts PaymentRefundAccount[]
  statusHistory  PaymentStatusHistory[]
  cashReceipts   CashReceipt[]
  apiLogs        PaymentApiLog[]
  webhookEvents  PaymentWebhookEvent[]

  @@unique([orderId, attemptNo])
  @@index([status, statusChangedAt]) // 대사 대상 찾기 (오래된 IN_PROGRESS·UNKNOWN)
  @@index([pgOrderId])
}

// 카드 결제 상세 (카드번호는 토스가 가린 값만)
model PaymentCard {
  paymentId             Int           @id
  issuerCode            String // 발급사 코드
  acquirerCode          String? // 매입사 코드
  numberMasked          String // 43301234****123* (원래 번호 저장 금지)
  installmentPlanMonths Int // 할부 개월 (0 = 일시불)
  isInterestFree        Boolean // 무이자 여부
  interestPayer         String? // 할부 수수료 부담 (BUYER / CARD_COMPANY / MERCHANT)
  approveNo             String // 카드사 승인번호
  cardType              CardType
  ownerType             CardOwnerType
  acquireStatus         String? // 매입 상태 (READY / REQUESTED / COMPLETED / CANCEL_REQUESTED / CANCELED)
  useCardPoint          Boolean       @default(false)
  amount                Int // 카드로 결제한 금액 (즉시 할인 포함)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

// 간편결제 상세 (토스페이·카카오페이·네이버페이 등)
model PaymentEasyPay {
  paymentId      Int    @id
  provider       String // 간편결제사 (토스페이, 카카오페이 …)
  amount         Int // 간편결제 잔액·계좌로 결제한 금액
  discountAmount Int // 간편결제사 즉시 할인

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

// 가상계좌 상세 (계좌번호·입금자명은 암호화)
model PaymentVirtualAccount {
  paymentId        Int                @id
  accountType      VirtualAccountType
  bankCode         String
  accountNumberEnc String // 발급된 가상계좌 번호 암호문 (구매자에게 보여 줘야 해서 복호화 가능하게)
  customerNameEnc  String? // 입금자명 암호문
  dueDate          DateTime // 입금 기한
  expired          Boolean            @default(false)
  settlementStatus String? // INCOMPLETED / COMPLETED
  refundStatus     String? // NONE / PENDING / FAILED / PARTIAL_FAILED / COMPLETED
  depositedAt      DateTime? // 입금 확인 시각
  updatedAt        DateTime           @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([dueDate]) // 기한 지난 입금 대기 찾기
}

// 가상계좌 환불 계좌 (입금 후 취소할 때 필요). 환불이 끝나면 암호문을 지우고 가린 값만 남김
model PaymentRefundAccount {
  id                  Int       @id @default(autoincrement())
  paymentId           Int
  bankCode            String
  accountNumberEnc    String? // 계좌번호 암호문 (환불 후 파기 → NULL)
  accountNumberMasked String // ******1234
  holderNameEnc       String? // 예금주 암호문 (환불 후 파기 → NULL)
  holderNameMasked    String // 홍*동
  createdAt           DateTime  @default(now())
  wipedAt             DateTime? // 파기 시각

  payment        Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cancels        PaymentCancel[]
  returnRequests ReturnRequest[] // 이 계좌로 환불하는 반품

  @@index([paymentId])
}

// 결제 취소 (부분·전체). 행을 추가하면 금액 한도를 트리거가 검사하고, DONE이 되면 결제 금액·상태를 트리거가 맞춤
model PaymentCancel {
  id                    Int                 @id @default(autoincrement())
  paymentId             Int
  cancelAmount          Int
  taxFreeAmount         Int                 @default(0)
  reasonCode            PaymentCancelReason
  reasonText            String // 토스에 보내는 취소 사유 (200자 이내)
  requestedBy           PaymentActor
  requestedByRef        String? // 요청한 관리자 등
  status                PaymentCancelStatus
  idempotencyKey        String              @unique // 같은 키로 다시 요청하면 두 번 취소되지 않음
  transactionKey        String?             @unique // 토스 취소 거래 키
  refundableAmountAfter Int? // 취소 후 남은 취소 가능 금액 (토스 응답)
  refundAccountId       Int?
  failCode              String?
  failMessage           String?
  requestedAt           DateTime
  canceledAt            DateTime?
  updatedAt             DateTime            @updatedAt

  payment        Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundAccount  PaymentRefundAccount? @relation(fields: [refundAccountId], references: [id], onDelete: Restrict)
  returnRequests ReturnRequest[] // 이 취소로 환불한 반품

  @@index([paymentId])
  @@index([status, requestedAt]) // 응답 못 받은 취소 찾기
}

// 결제 상태 이력 (트리거가 자동 기록, 수정·삭제 금지)
model PaymentStatusHistory {
  id             Int                 @id @default(autoincrement())
  paymentId      Int
  fromStatus     PaymentStatus?
  toStatus       PaymentStatus
  source         PaymentStatusSource
  canceledAmount Int // 그 시점 취소 금액 합계
  failCode       String?
  changedAt      DateTime

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, id])
}

// 토스 API 호출 기록 (장애 분석·대사용, 민감정보는 가려서 저장, 1년 보관)
model PaymentApiLog {
  id             Int                 @id @default(autoincrement())
  paymentId      Int?
  orderId        Int?
  operation      PaymentApiOperation
  httpMethod     String // POST / GET
  path           String // /v1/payments/confirm (키 값은 넣지 않음)
  idempotencyKey String?
  httpStatus     Int? // 응답을 못 받으면 없음
  outcome        PaymentApiOutcome
  errorCode      String?
  errorMessage   String?
  requestBody    String? // JSON (민감정보 가림)
  responseBody   String? // JSON (민감정보 가림, 최대 20,000자)
  durationMs     Int
  createdAt      DateTime            @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([createdAt]) // 1년 지난 기록 정리
}

// 토스 웹훅 원문 (받자마자 저장 → 토스 조회로 확인 후 반영)
model PaymentWebhookEvent {
  id             Int                @id @default(autoincrement())
  eventType      String // PAYMENT_STATUS_CHANGED / DEPOSIT_CALLBACK / …
  dedupKey       String             @unique // 같은 알림을 두 번 처리하지 않도록
  transmissionId String? // 토스 전송 ID (재전송마다 바뀌므로 중복 판단에 쓰지 않음)
  retriedCount   Int                @default(0) // 토스가 다시 보낸 횟수
  paymentKey     String?
  pgOrderId      String?
  paymentId      Int?
  payload        String // JSON (secret 등 민감정보 가림)
  status         WebhookEventStatus @default(RECEIVED)
  attempts       Int                @default(0) // 우리가 처리를 시도한 횟수
  lastError      String?
  receivedAt     DateTime
  processedAt    DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, receivedAt])
}

// 현금영수증 (가상계좌·계좌이체에서 구매자가 신청하면 토스가 발급)
model CashReceipt {
  id            Int               @id @default(autoincrement())
  paymentId     Int
  type          CashReceiptType
  receiptKey    String?           @unique
  issueNumber   String? // 국세청 승인번호
  receiptUrl    String?
  amount        Int
  taxFreeAmount Int               @default(0)
  status        CashReceiptStatus @default(ISSUED)
  issuedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

// 주문 안의 상품 한 줄 (어떤 주문에, 어떤 SKU를, 몇 개)
// 상품명·컬러·사이즈·가격은 "주문 당시 값"을 복사해 둡니다(스냅샷).
// 나중에 상품 이름이나 가격이 바뀌어도 주문 내역은 그대로 남아야 하기 때문입니다.
// ⑦ 주문: 상품 줄마다 상태(물건)와 금액 배분(환불 기준)을 가집니다. 만든 뒤 수량·가격·스냅샷은 바꿀 수 없음
model OrderItem {
  id       Int @id @default(autoincrement())
  orderId  Int
  lineNo   Int // ★ 주문 안 순번 1, 2, 3 … (고객센터: "주문번호 2번 상품")
  skuId    Int // 실제로 주문한 단위 (컬러 + 사이즈). 한 주문에 같은 SKU는 한 줄만
  quantity Int

  // 가격 스냅샷 (1개 기준): 정가 − 할인 = 판매가
  listPrice      Int // 주문 당시 정가
  discountAmount Int // 주문 당시 1개당 할인액
  price          Int // 주문 당시 1개 판매가 (= listPrice − discountAmount)
  promotionId    Int? // 적용된 할인 행사 (행사가 지워져도 주문은 남도록 SetNull)
  promotionName  String? // 스냅샷: 행사 이름이 나중에 바뀌어도 당시 이름 유지

  // 금액 배분 (줄 합계, CHECK로 계산 일치) — 부분 취소·반품 환불의 기준
  lineListTotal     Int // ★ 정가 × 수량
  lineDiscountTotal Int // ★ 할인 × 수량
  lineTotal         Int // ★ 판매가 × 수량
  couponAllocated   Int @default(0) // ★ 이 줄이 나눠 가진 주문 쿠폰 할인 (⑬)
  pointAllocated    Int @default(0) // ★ 이 줄이 나눠 가진 포인트 사용 (⑭)
  payAmount         Int // ★ 이 줄의 실결제액 = lineTotal − 쿠폰 몫 − 포인트 몫 (배송비 제외)

  styleCode String // 스냅샷: JK26F001
  skuCode   String // 스냅샷: JK26F001-BK-100
  styleName String // 스냅샷: 울 블렌드 싱글 자켓
  colorName String // 스냅샷: 블랙
  sizeName  String // 스냅샷: 100
  imageUrl  String? // 스냅샷: 주문 당시 대표 이미지

  // 상태 (물건). 바꿀 때 statusChangedAt·statusChangedBy를 함께 바꾸면 트리거가 이력을 남김
  status          OrderItemStatus @default(AWAITING_PAYMENT) // ★
  statusChangedAt DateTime // ★
  statusChangedBy OrderActor      @default(SYSTEM) // ★
  statusMemo      String? // ★
  paidAt          DateTime? // ★ 단계별 시각 (그 단계에 들어갔으면 필수 — CHECK)
  preparingAt     DateTime? // ★
  shippedAt       DateTime? // ★
  deliveredAt     DateTime? // ★
  confirmedAt     DateTime? // ★
  canceledAt      DateTime? // ★
  returnedAt      DateTime? // ★ 반품 완료(검수 통과) 시각
  confirmType     ConfirmType? // ★ 구매확정 방식 (CONFIRMED일 때만)
  autoConfirmAt   DateTime? // ★ 자동 구매확정 예정 시각 (배송 완료 + 7일. 정책이 바뀌어도 이미 정해진 날짜 유지)
  createdAt       DateTime        @default(now())

  order         Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sku           Sku                      @relation(fields: [skuId], references: [id], onDelete: Restrict)
  promotion     PricePromotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  reservations  InventoryReservation[] // 재고 예약 (갱신되면 여러 행, 살아 있는 것은 1개)
  shipmentItems ShipmentItem[]
  statusHistory OrderItemStatusHistory[]
  returnItems   ReturnItem[]
  coupons       OrderItemCoupon[] // 이 줄이 나눠 가진 쿠폰 할인

  @@unique([orderId, lineNo])
  @@unique([orderId, skuId]) // ★ 같은 SKU 두 줄 금지 (예약과 1:1로 짝짓는 근거)
  @@index([skuId])
  @@index([status, autoConfirmAt]) // 자동 구매확정 대상
}

// ---------------------------------------------------------------
// 로그인(Auth.js)용 표들. Auth.js가 정한 형태 그대로 써야 합니다.
// ---------------------------------------------------------------

// 회원
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String? // 프로필 사진 주소 (GitHub 아바타)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  customer Customer? // 쇼핑몰 고객 (1:1). 탈퇴하면 이 User는 삭제되고 Customer는 익명화되어 남음
}

// 어떤 외부 서비스(GitHub 등) 계정으로 로그인했는지
model Account {
  userId            String
  type              String
  provider          String // 예: "github"
  providerAccountId String // GitHub에서의 사용자 번호
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// 로그인 상태 (브라우저 쿠키에 sessionToken이 저장됩니다)
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // "로그인 상태 유지"를 체크하지 않은 로그인 (lib/auth-session.ts)
  //  - absoluteExpiresAt: 이 시각(로그인 + 12시간)이 지나면 사용 중이어도 무조건 만료. 비어 있으면 상태 유지(30일, 사용할 때마다 연장)
  //  - browserKeyHash   : 브라우저를 닫으면 사라지는 쿠키 값의 해시. 쿠키가 없거나 다르면 로그아웃으로 처리
  absoluteExpiresAt DateTime?
  browserKeyHash    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 이메일 로그인용 (지금은 사용하지 않지만 Auth.js 어댑터가 요구합니다)
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ===============================================================
// 재고 보강 (2안: 문서 기반)
//
//   발주·입고:  Manufacturer(거래처) 1 ──< PurchaseOrder ──< PurchaseOrderLine (SKU·수량·입고 예정일)
//                                              └─< PurchaseOrderEvent (확정·날짜 변경·취소 이력)
//               InboundReceipt ──< InboundReceiptLine (정상·불량 수량) ──< InventoryLedger (INBOUND)
//   재입고 예정일 = 확정된 발주 줄 중 남은 수량이 있는 가장 빠른 예정일 (저장하지 않고 계산)
//   재입고 알림: RestockSubscription (회원 × SKU) → Notification (알림함 + 발송 대기열)
//   품절 임박:  InventoryBalance.reorderPoint → StockAlert (재주문 필요 발생·해소)
//   반품:       ReturnRequest ──< ReturnItem (주문 상품 줄) ──< InventoryLedger
//               도착 = 반품센터 +1 (판매 불가) → 검수: 정상 = 물류센터로 이동(판매 가능) / 불량 = 불량 창고로 / 반품 불가 = 고객에게 반송
//               검수 후 환불 = 반품 상품 실결제액 − 반품 배송비(고객 사유) → 토스 부분 취소
// ===============================================================

enum PurchaseOrderStatus {
  DRAFT // 작성 중 (거래처에 보내기 전)
  ORDERED // 발주함 (입고 날짜 미정)
  CONFIRMED // 거래처가 입고 날짜 확정 → 재입고 예정일로 안내
  PARTIALLY_RECEIVED // 일부 입고
  RECEIVED // 입고 완료
  CANCELED // 취소 (입고 전만)
}

enum PurchaseOrderEventType {
  CREATED
  ORDERED
  CONFIRMED // 입고 날짜 확정
  DATE_CHANGED // 입고 예정일 변경
  RECEIVED // 입고 (일부·전부)
  CANCELED
}

enum RestockSubscriptionStatus {
  WAITING // 신청함 (아직 재입고 일정 없음)
  SCHEDULED // 재입고 예정일을 안내함 (예정일 변경 시 다시 안내)
  ARRIVED // 재입고를 안내함 (끝)
  PURCHASED // 재입고 안내 뒤 그 상품을 구매함 (끝)
  CANCELED // 고객이 취소 (끝)
  EXPIRED // 90일 동안 재입고가 없어 만료 (끝)
}

enum NotificationType {
  RESTOCK_SCHEDULED // 재입고 예정일 안내
  RESTOCK_RESCHEDULED // 재입고 예정일 변경
  RESTOCK_CANCELED // 재입고 일정 취소
  RESTOCK_ARRIVED // 재입고됨
  RETURN_UPDATE // 반품 진행 (승인·회수·검수·환불·거절)
  REORDER_NEEDED // (관리자) 재주문 필요
  COUPON_ISSUED // 쿠폰 발급 (가입·생일·등급·관리자 지급)
  COUPON_EXPIRING // 쿠폰 만료 임박 (7일 전)
}

enum NotificationChannel {
  IN_APP // 사이트 알림함
  EMAIL // (배포 때 연결)
  KAKAO // 카카오 알림톡 (배포 때 연결)
}

enum NotificationStatus {
  PENDING // 보낼 차례 (외부 채널)
  SENT // 보냄 (알림함은 만들자마자 SENT)
  FAILED
}

enum StockAlertStatus {
  OPEN // 재주문 필요
  RESOLVED // 해소 (재고 회복·발주 진행)
}

enum StockAlertResolution {
  RESTOCKED // 판매 가능 수량이 재주문점 위로 회복
  PURCHASE_ORDERED // 발주가 진행 중
  THRESHOLD_CHANGED // 재주문점을 바꿈
}

enum ReturnStatus {
  REQUESTED // 고객 신청
  APPROVED // 승인 (회수 준비)
  COLLECTING // 회수 송장 등록 → 회수중
  RECEIVED // 반품센터 도착 (검수 전, 판매 불가 재고)
  INSPECTED // 검수 끝 → 환불 대기 (환불 실패·응답 없음이면 여기서 다시 시도)
  COMPLETED // 환불 완료 (또는 환불할 금액 0)
  REJECTED // 반품 불가 (승인 거절 또는 검수 결과 전부 반품 불가)
  CANCELED // 고객 철회 (회수 전까지)
}

enum ReturnReason {
  CHANGE_OF_MIND // 단순 변심 (고객 부담, 배송 완료 7일 안)
  SIZE // 사이즈·핏 (고객 부담, 7일 안)
  DEFECT // 불량 (판매자 부담, 30일 안)
  WRONG_ITEM // 오배송 (판매자 부담, 30일 안)
  DAMAGED // 배송 중 파손 (판매자 부담, 30일 안)
}

enum ReturnFault {
  CUSTOMER // 고객 사유 → 반품 배송비 차감
  SELLER // 판매자 사유 → 무료 (전부 반품이면 처음 배송비도 환불)
}

enum ReturnInspection {
  RESELLABLE // 정상 → 물류센터로 (다시 판매)
  DEFECTIVE // 불량 → 불량 창고로 (환불은 함)
  NOT_RETURNABLE // 반품 불가 (사용 흔적·훼손) → 고객에게 반송, 환불 없음
}

// 발주 (거래처에 상품을 주문)
model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  poNo            String              @unique // PO-20261118-001
  supplierId      Int // 거래처 (제조사·공급사)
  status          PurchaseOrderStatus @default(DRAFT)
  orderedAt       DateTime?
  confirmedAt     DateTime?
  canceledAt      DateTime?
  statusChangedAt DateTime
  createdBy       String // 처리자 (관리자 단계에서 FK)
  memo            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier    Manufacturer         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]
  events      PurchaseOrderEvent[]
  receipts    InboundReceipt[]
  sizeGroup   SizeGroup?           @relation(fields: [sizeGroupId], references: [id])
  sizeGroupId Int?

  @@index([status])
}

// 발주 줄 (SKU별 수량·입고 예정일). 입고된 수량은 입고 전표로 트리거가 계산
model PurchaseOrderLine {
  id              Int       @id @default(autoincrement())
  purchaseOrderId Int
  lineNo          Int
  skuId           Int
  qtyOrdered      Int
  qtyReceived     Int       @default(0) // 입고된 수량 (정상 + 불량, 트리거만 바꿈)
  expectedAt      DateTime? // 입고 예정일 (확정되면 필수, 한국 날짜 0시로 저장)
  unitCost        Int? // 매입 단가 (원, 선택)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  sku           Sku                  @relation(fields: [skuId], references: [id], onDelete: Restrict)
  receiptLines  InboundReceiptLine[]
  events        PurchaseOrderEvent[]

  @@unique([purchaseOrderId, lineNo])
  @@unique([purchaseOrderId, skuId])
  @@index([skuId, expectedAt]) // SKU별 재입고 예정일
}

// 발주 이력 (추가만 가능)
model PurchaseOrderEvent {
  id              Int                    @id @default(autoincrement())
  purchaseOrderId Int
  lineId          Int? // 줄 단위 이벤트 (예정일 변경 등)
  type            PurchaseOrderEventType
  fromDate        DateTime?
  toDate          DateTime?
  memo            String?
  createdBy       String
  createdAt       DateTime

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  line          PurchaseOrderLine? @relation(fields: [lineId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId, id])
}

// 입고 전표 (실제로 물건이 들어온 기록)
model InboundReceipt {
  id              Int      @id @default(autoincrement())
  receiptNo       String   @unique // IN-20261118-001
  purchaseOrderId Int? // 발주 없이 들어온 입고(샘플 등)는 비움
  locationId      Int // 입고 창고 (정상품이 들어가는 곳)
  receivedAt      DateTime
  createdBy       String
  memo            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  location      InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines         InboundReceiptLine[]
}

// 입고 전표 줄: 정상 수량은 입고 창고, 불량 수량은 불량 창고 (원장이 줄마다 생김)
model InboundReceiptLine {
  id                  Int  @id @default(autoincrement())
  receiptId           Int
  purchaseOrderLineId Int?
  skuId               Int
  qtyGood             Int // 정상
  qtyDefect           Int  @default(0) // 입고 검수 불량

  receipt           InboundReceipt     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  sku               Sku                @relation(fields: [skuId], references: [id], onDelete: Restrict)
  ledgers           InventoryLedger[]

  @@index([purchaseOrderLineId])
  @@index([skuId])
}

// 재입고 알림 신청 (회원 × SKU, 진행 중인 신청은 1개만)
model RestockSubscription {
  id                 Int                       @id @default(autoincrement())
  customerId         Int
  skuId              Int
  status             RestockSubscriptionStatus @default(WAITING)
  notifiedExpectedAt DateTime? // 마지막으로 안내한 재입고 예정일 (바뀌면 다시 안내)
  scheduledAt        DateTime? // 예정일을 처음 안내한 시각
  arrivedAt          DateTime? // 재입고를 안내한 시각
  closedAt           DateTime? // 끝난 시각 (재입고 안내·구매·취소·만료)
  expiresAt          DateTime // 신청 + 90일
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([skuId, status])
  @@index([customerId, status])
  @@index([status, expiresAt])
}

// 알림: 사이트 알림함(IN_APP) + 외부 발송 대기열(EMAIL·KAKAO, 배포 때 연결)
// 같은 일로 두 번 보내지 않도록 dedupKey 유일 (예: restock-arrived:구독id)
model Notification {
  id         Int                 @id @default(autoincrement())
  customerId Int? // 받는 회원 (관리자 알림은 비움)
  audience   String // CUSTOMER / ADMIN
  type       NotificationType
  channel    NotificationChannel @default(IN_APP)
  title      String
  body       String
  linkUrl    String? // 누르면 갈 곳 (사이트 안 경로만)
  dedupKey   String              @unique
  status     NotificationStatus  @default(SENT)
  attempts   Int                 @default(0)
  sentAt     DateTime?
  readAt     DateTime?
  createdAt  DateTime

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, readAt, id]) // 안 읽은 알림
  @@index([audience, createdAt])
  @@index([status, channel])
}

// 재주문 필요 알림 (SKU × 위치, 진행 중인 알림은 1개만)
model StockAlert {
  id              Int                   @id @default(autoincrement())
  skuId           Int
  locationId      Int
  status          StockAlertStatus      @default(OPEN)
  availableAtOpen Int // 발생 때 판매 가능 수량
  reorderPoint    Int // 발생 때 재주문점
  openedAt        DateTime
  resolvedAt      DateTime?
  resolution      StockAlertResolution?

  sku      Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([status, openedAt])
  @@index([skuId, locationId, status])
}

// 반품 요청 (주문 1개 안의 상품 줄 여러 개를 함께)
model ReturnRequest {
  id                Int          @id @default(autoincrement())
  returnNo          String       @unique // R + 주문번호 + 순번 (R20261118-48213907-1)
  orderId           Int
  status            ReturnStatus @default(REQUESTED)
  reason            ReturnReason
  reasonText        String? // 고객이 쓴 설명
  fault             ReturnFault // 사유로 정해짐 (단순 변심·사이즈 = 고객, 불량·오배송·파손 = 판매자)
  requestedBy       String // CUSTOMER / ADMIN
  returnShippingFee Int          @default(0) // 반품 배송비 (고객 사유일 때, 검수 끝나며 확정)
  refundAmount      Int? // 환불액 (검수 끝나며 확정)
  refundAccountId   Int? // 가상계좌 결제 환불 계좌 (암호화, 환불 후 파기)
  paymentCancelId   Int? // 환불한 결제 취소
  pickupCourierId   Int? // 회수 택배사
  pickupTrackingNo  String? // 회수 송장
  statusChangedAt   DateTime
  requestedAt       DateTime
  approvedAt        DateTime?
  collectingAt      DateTime?
  receivedAt        DateTime?
  inspectedAt       DateTime?
  completedAt       DateTime?
  closedAt          DateTime? // 거절·철회 시각
  memo              String? // 처리 메모 (거절 사유 등)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundAccount PaymentRefundAccount? @relation(fields: [refundAccountId], references: [id], onDelete: Restrict)
  paymentCancel PaymentCancel?        @relation(fields: [paymentCancelId], references: [id], onDelete: Restrict)
  pickupCourier Courier?              @relation(fields: [pickupCourierId], references: [id], onDelete: Restrict)
  items         ReturnItem[]

  @@index([orderId])
  @@index([status, statusChangedAt])
}

// 반품 상품 (주문 상품 줄 단위. 지금은 줄 수량 전체 — 부분 수량은 ⑩)
model ReturnItem {
  id              Int               @id @default(autoincrement())
  returnRequestId Int
  orderItemId     Int
  qty             Int
  inspection      ReturnInspection? // 검수 결과
  inspectedAt     DateTime?
  inspectionMemo  String?
  refundAmount    Int? // 이 상품 몫 환불액 (정상·불량 = 실결제액, 반품 불가 = 0)

  returnRequest ReturnRequest     @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem     OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  ledgers       InventoryLedger[]

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

// =====================================================================
// ⑬ 쿠폰 (B안: 정책 · 발급 · 사용 분리)
//
//   CouponPolicy ── 어떤 쿠폰인가 (종류·할인·조건·발급 방식·사용 기간)
//    ├─ CouponPolicyTarget  적용 대상 (할인 행사와 같은 방식: 전체/카테고리/시즌/성별/상품, 포함·제외)
//    ├─ CouponPolicyGrade   받을 수 있는 등급 (없으면 전원)
//    ├─ CouponCode          입력 코드 ("WELCOME2026")
//    └─ CustomerCoupon      고객이 가진 1장 (쿠폰번호, 사용 기간은 발급 때 복사)
//         ├─ CustomerCouponHistory  상태 이력 (트리거가 기록)
//         └─ OrderCoupon            주문에 쓴 기록: 예약(RESERVED) → 사용(APPLIED) / 해제(RELEASED) / 결제 후 취소(CANCELED)
//              └─ OrderItemCoupon   상품 줄별 할인 배분 (합계 = OrderItem.couponAllocated)
//
// ★ 쿠폰도 재고처럼: 주문을 만들 때 "예약", 결제되면 "사용", 결제 안 되면 바로 "복원".
//   앱은 쿠폰 상태를 직접 바꾸지 않습니다. 주문 상태가 바뀌면 트리거가 OrderCoupon → CustomerCoupon 순서로 바꿈.
// =====================================================================

enum CouponKind {
  PRODUCT // 상품 쿠폰: 상품 줄 1개에 1장
  ORDER // 장바구니 쿠폰: 주문당 1장, 대상 상품 금액 전체에
  SHIPPING // 배송비 쿠폰: 주문당 1장, 기본 배송비만 (제주·도서산간 추가 배송비는 할인 안 함)
}

enum CouponDiscountType {
  RATE // 정률 N% (10원 미만 버림)
  AMOUNT // 정액 N원
  FREE_SHIPPING // 기본 배송비 전액 (배송비 쿠폰만)
}

enum CouponIssueMethod {
  DOWNLOAD // 고객이 [쿠폰 받기]
  AUTO // 조건이 되면 자동 (가입·생일·등급)
  CODE // 코드 입력
  ADMIN // 관리자 지급만 (CS 보상 등)
}

enum CouponAutoTrigger {
  SIGNUP // 가입 축하
  BIRTHDAY // 생일 월 (해마다 1장)
  GRADE_MONTHLY // 등급 혜택 (매월 1장)
}

// 정책 상태. 활성화 후에는 할인 규칙을 바꿀 수 없음 (이미 받은 고객과 약속이 달라지므로)
enum CouponPolicyStatus {
  DRAFT // 작성 중 (대상·등급 편집 가능)
  ACTIVE // 발급·사용 가능
  PAUSED // 긴급 중지: 발급·사용 모두 멈춤 (잘못 만든 쿠폰 등)
  ENDED // 발급 종료 (이미 받은 쿠폰은 사용 기간까지 사용 가능)
}

enum CustomerCouponStatus {
  AVAILABLE // 사용 가능
  IN_USE // 결제 대기 주문에 예약됨
  USED // 결제 완료 주문에 사용됨
  EXPIRED // 기간 만료 (또는 취소로 돌아왔는데 기간이 지남)
  REVOKED // 회수 (탈퇴·관리자)
}

enum OrderCouponStatus {
  RESERVED // 결제 대기 주문에 예약
  APPLIED // 결제 완료 → 사용
  RELEASED // 결제 안 됨(이탈·만료·대체) → 쿠폰 돌려줌
  CANCELED // 결제 후 전체 취소 → 기간이 남았으면 돌려줌, 지났으면 소멸
}

model CouponPolicy {
  id          Int     @id @default(autoincrement())
  code        String  @unique // WELCOME_10 (내부 관리 코드)
  name        String // 관리자용 이름
  displayName String // 고객에게 보이는 이름 "신규가입 10% 할인"
  description String? // 유의 사항 (고객 표시)

  kind              CouponKind
  discountType      CouponDiscountType
  discountValue     Int // RATE: 10(%) / AMOUNT: 5000(원) / FREE_SHIPPING: 0
  maxDiscountAmount Int? // 정률 최대 할인 (원)
  minOrderAmount    Int     @default(0) // 최소 구매 금액: 상품 쿠폰 = 그 상품 줄, 장바구니 = 대상 상품 합계, 배송비 = 상품 합계 (모두 판매가 기준)
  applyToSaleItems  Boolean @default(true) // 할인 행사 중인 상품에도 적용 (false면 행사 상품 제외)

  issueMethod      CouponIssueMethod
  autoTrigger      CouponAutoTrigger? // AUTO일 때만
  issueStartAt     DateTime // 발급 기간 (이 시각부터)
  issueEndAt       DateTime // 이 시각 직전까지
  totalQuantity    Int? // 선착순 총 수량 (null = 무제한)
  issuedCount      Int     @default(0) // 발급된 수 (트리거가 관리)
  perCustomerLimit Int? // 1인당 평생 발급 한도 (생일·등급처럼 주기적인 쿠폰은 null + 주기별 1장)

  // 사용 기간: 고정(useStartAt~useEndAt) 또는 발급일부터 N일 (발급일 포함 N일째 23:59:59 KST까지)
  useStartAt DateTime?
  useEndAt   DateTime?
  validDays  Int?

  status          CouponPolicyStatus @default(DRAFT)
  statusChangedAt DateTime
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  targets CouponPolicyTarget[]
  grades  CouponPolicyGrade[]
  codes   CouponCode[]
  issued  CustomerCoupon[]

  @@index([status, issueMethod])
}

// 적용 대상 (상품·장바구니 쿠폰). 할인 행사의 대상(PricePromotionTarget)과 같은 규칙: 제외가 포함보다 우선, 카테고리는 하위 포함
model CouponPolicyTarget {
  id         Int                 @id @default(autoincrement())
  policyId   Int
  targetType PromotionTargetType
  mode       TargetMode          @default(INCLUDE)
  categoryId Int?
  seasonId   Int?
  gender     Gender?
  styleId    Int?
  createdAt  DateTime            @default(now())

  policy   CouponPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  category Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  season   Season?      @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  style    Style?       @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@index([policyId])
}

// 받을 수 있는 등급 (행이 없으면 전원)
model CouponPolicyGrade {
  policyId Int
  gradeId  Int

  policy CouponPolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  grade  CustomerGrade @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  @@id([policyId, gradeId])
}

// 입력 코드 (공용 코드: 여러 고객이 같은 코드, 1인 한도는 정책의 perCustomerLimit)
model CouponCode {
  id        Int      @id @default(autoincrement())
  policyId  Int
  code      String   @unique // 대문자·숫자 4~20자 (입력은 대소문자 구분 없이 대문자로 바꿔 찾음)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  policy CouponPolicy     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  issued CustomerCoupon[]
}

// 쿠폰 코드 입력 시도 (무차별 대입 방지: 1시간에 10번 틀리면 막음). 추가만
model CouponCodeAttempt {
  id         Int      @id @default(autoincrement())
  customerId Int
  success    Boolean
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
}

// 고객이 가진 쿠폰 1장. 사용 기간은 발급 때 정해져 바뀌지 않음
model CustomerCoupon {
  id           Int               @id @default(autoincrement())
  couponNo     String            @unique // CP + 대문자·숫자 10자 (고객·CS 안내용)
  policyId     Int
  customerId   Int
  issueMethod  CouponIssueMethod // 이 장을 받은 방법 (정책 방식 또는 ADMIN)
  couponCodeId Int? // 코드로 받았으면
  issueKey     String? // 주기 발급 중복 방지 (BIRTHDAY:2026, GRADE:202611, SIGNUP)
  issuedBy     String // CUSTOMER / SYSTEM / ADMIN:아이디
  issuedAt     DateTime
  validFrom    DateTime
  validTo      DateTime // 이 시각 직전까지 사용 가능

  status           CustomerCouponStatus @default(AVAILABLE)
  statusChangedAt  DateTime
  statusReason     String? // 회수·만료 사유
  expiryNotifiedAt DateTime? // 만료 임박 안내 보낸 시각
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  policy   CouponPolicy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  customer Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  code     CouponCode?             @relation(fields: [couponCodeId], references: [id], onDelete: Restrict)
  history  CustomerCouponHistory[]
  uses     OrderCoupon[]

  @@unique([policyId, customerId, issueKey])
  @@index([customerId, status, validTo])
  @@index([status, validTo])
}

// 쿠폰 상태 이력 (트리거가 기록, 추가만)
model CustomerCouponHistory {
  id               Int                   @id @default(autoincrement())
  customerCouponId Int
  fromStatus       CustomerCouponStatus?
  toStatus         CustomerCouponStatus
  orderId          Int? // 주문 때문에 바뀌었으면
  reason           String?
  changedAt        DateTime

  customerCoupon CustomerCoupon @relation(fields: [customerCouponId], references: [id], onDelete: Restrict)

  @@index([customerCouponId])
}

// 주문에 쓴 쿠폰 (쿠폰 1장이 여러 주문에 걸칠 수 있음: 이탈로 돌려받은 뒤 다시 쓰면. 살아 있는 것은 1개)
model OrderCoupon {
  id               Int               @id @default(autoincrement())
  orderId          Int
  customerCouponId Int
  kind             CouponKind // 정책 종류 복사 (주문당 장바구니·배송비 1장 검사용)
  couponName       String // 표시 이름 스냅샷
  discountAmount   Int // 이 쿠폰의 할인액 (상품·장바구니 = 줄 배분 합계, 배송비 = 배송비 할인)
  status           OrderCouponStatus @default(RESERVED)
  appliedAt        DateTime?
  releasedAt       DateTime?
  canceledAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerCoupon CustomerCoupon    @relation(fields: [customerCouponId], references: [id], onDelete: Restrict)
  items          OrderItemCoupon[]

  @@index([orderId])
  @@index([customerCouponId])
}

// 상품 줄별 쿠폰 할인 배분 (반품 환불 기준). 상품 쿠폰은 줄 1개, 장바구니 쿠폰은 대상 줄 전부에 금액 비율로
model OrderItemCoupon {
  id            Int @id @default(autoincrement())
  orderCouponId Int
  orderItemId   Int
  amount        Int

  orderCoupon OrderCoupon @relation(fields: [orderCouponId], references: [id], onDelete: Restrict)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderCouponId, orderItemId])
  @@index([orderItemId])
}
