// 데이터베이스 설계도입니다. 여기서 "model" 하나가 표(테이블) 하나가 됩니다.
// 수정한 뒤에는 `npm run db:migrate`로 실제 데이터베이스에 반영하세요.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ⚠️ DB 제약조건(CHECK·트리거)은 Prisma 문법으로 쓸 수 없어서 prisma/db-constraints.ts에 따로 정의합니다.
//    마이그레이션 SQL을 만든 뒤 `npm run db:constraints -- <migration.sql>`로 주입하고,
//    `npm run db:verify`로 제약이 살아 있는지·데이터가 규칙을 지키는지 확인합니다.

// ===============================================================
// 상품 도메인 (B안: 스타일 → 컬러 → SKU 3단 구조)
//
//   Style (JK26F001 울 블렌드 싱글 자켓)          ← 상세페이지 1개
//    └─ StyleColor (JK26F001-BK 블랙)             ← 컬러별 사진·판매상태
//        └─ Sku (JK26F001-BK-100)                 ← 재고·주문의 실제 단위
//
// 마스터(기준 정보): Season, Category, Color, SizeGroup, Size, Material, Manufacturer, CareSymbol
// 상세 정보: StyleColorImage, StyleMaterial, SizeMeasurement, ModelWear, StyleNotice,
//            StyleCare, StyleWearSeason, StyleDetailBlock
// ===============================================================

// ---------- 코드값(enum): 정해진 값만 들어가게 막습니다 ----------

// 성별 구분
enum Gender {
  MEN
  WOMEN
  UNISEX
}

// 스타일 판매 상태. "품절"은 상태로 두지 않고 재고(Sku.stock)로 계산합니다.
// (상태로 두면 재고가 들어와도 누가 상태를 바꿔줘야 해서 어긋나기 쉬움)
enum StyleStatus {
  DRAFT // 작성 중 (고객에게 안 보임)
  ON_SALE // 판매 중
  SUSPENDED // 일시 중지
  DISCONTINUED // 판매 종료 (주문 내역 때문에 삭제하지 않음)
}

// 컬러·SKU 단위 판매 상태
enum SaleStatus {
  ON_SALE
  SUSPENDED
  DISCONTINUED
}

// 시즌 구분
enum SeasonTerm {
  SS // Spring/Summer 봄·여름
  FW // Fall/Winter 가을·겨울
  ALL // 시즌 없는 상시 판매(캐리오버)
}

// 컬러 계열 (필터용). "차콜"과 "그레이"는 모두 GRAY 계열
enum ColorFamily {
  BLACK
  WHITE
  GRAY
  BEIGE
  BROWN
  NAVY
  BLUE
  GREEN
  RED
  PINK
  YELLOW
  PURPLE
  MULTI
}

// 핏
enum Fit {
  SLIM
  REGULAR
  RELAXED
  OVERSIZED
}

// 두께감 / 신축성 / 비침 / 안감에 공통으로 쓰는 3단계
enum Level3 {
  LOW
  MEDIUM
  HIGH
}

// 안감
enum Lining {
  NONE
  PARTIAL
  FULL
}

// 상품정보제공고시 품목군 (전자상거래법상 의무 표시 항목의 종류)
enum NoticeType {
  CLOTHING // 의류
  SHOES // 구두/신발
  BAG // 가방
  ACCESSORY // 패션잡화(모자/벨트/액세서리)
}

// 이미지 종류
enum ImageType {
  MAIN // 대표(정면) - 목록 카드에 사용
  BACK // 후면
  MODEL // 모델 착용
  DETAIL // 디테일 컷
}

// 소재 분류
enum MaterialKind {
  NATURAL // 천연 (면, 울, 린넨)
  SYNTHETIC // 합성 (폴리에스터, 나일론)
  REGENERATED // 재생 (레이온, 텐셀)
  LEATHER // 가죽
  OTHER // 고무 등
}

// 제조사 역할 (고시 정보의 "제조자(수입자)")
enum ManufacturerRole {
  MANUFACTURER // 제조사
  IMPORTER // 수입사
}

// 세탁 기호 분류 (KS 세탁 표시 기준의 큰 묶음)
enum CareCategory {
  WASH // 물세탁
  BLEACH // 표백
  DRY // 건조
  IRON // 다림질
  DRYCLEAN // 드라이클리닝
}

// 착용 계절감 (Season 테이블은 "출시 시즌", 이것은 "입기 좋은 계절")
enum WearSeason {
  SPRING
  SUMMER
  FALL
  WINTER
}

// 상세페이지 콘텐츠 블록 종류
enum DetailBlockType {
  TEXT // 제목 + 본문
  IMAGE // 이미지 1장 (+ 캡션)
  VIDEO // 영상 주소
}

// 실측 항목 (단위 cm)
enum MeasureItem {
  SHOULDER // 어깨너비
  CHEST // 가슴단면
  SLEEVE // 소매길이
  LENGTH // 총장
  WAIST // 허리단면
  HIP // 엉덩이단면
  THIGH // 허벅지단면
  RISE // 밑위
  HEM // 밑단단면
  HEAD // 머리둘레
  BRIM // 챙길이
  DEPTH // 깊이
}

// ---------- 마스터 테이블 ----------

// 시즌: 26SS, 26FW ... (어느 시즌에 기획·출시한 상품인지)
model Season {
  id        Int        @id @default(autoincrement())
  code      String     @unique // 26FW
  name      String // 2026 가을/겨울
  year      Int // 2026
  term      SeasonTerm
  startDate DateTime? // 시즌 판매 시작일
  endDate   DateTime? // 시즌 판매 종료일 (이후 이월상품)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  styles           Style[]
  promotionTargets PricePromotionTarget[]
}

// 표준 카테고리 트리: 아우터 > 자켓
// - parentId: 바로 위 부모 (인접 리스트)
// - path: 루트부터의 id 경로 "/1/4/" → 하위 전체 조회가 쉬움 (path LIKE '/1/%')
// 성별(남성/여성)은 여기 넣지 않고 Style.gender로 구분합니다.
// "남성 > 아우터" 같은 고객용 메뉴는 11번 전시 단계에서 따로 만듭니다.
model Category {
  id         Int         @id @default(autoincrement())
  parentId   Int?
  code       String      @unique // OUTER_JACKET (URL·연동용 고정 코드)
  name       String // 자켓
  path       String      @default("/") // /1/4/ — DB 트리거(Category_path_fill)가 부모 기준으로 자동 계산
  depth      Int         @default(1) // 1 = 대분류, 2 = 중분류 — 트리거가 자동 계산
  noticeType NoticeType? // 이 카테고리 상품의 기본 고시 품목군
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  parent           Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict) // 자식이 있으면 삭제 거부 (고아 카테고리 방지)
  children         Category[]             @relation("CategoryTree")
  styles           Style[]
  promotionTargets PricePromotionTarget[]

  @@index([parentId])
  @@index([path])
}

// 컬러 마스터: 이름을 통일하고, 컬러칩 색과 계열(필터)을 관리
model Color {
  id        Int         @id @default(autoincrement())
  code      String      @unique // BK (품번에 들어가는 2자리 코드)
  name      String // 블랙
  nameEn    String // BLACK
  hex       String // #1A1A1A (컬러칩 표시용)
  family    ColorFamily // BLACK 계열
  sortOrder Int         @default(0)

  styleColors StyleColor[]
}

// 사이즈 체계: 상의(숫자), 상의(알파벳), 하의(인치), 신발(mm), FREE
model SizeGroup {
  id   Int    @id @default(autoincrement())
  code String @unique // TOP_KR
  name String // 상의 (95~110)

  sizes  Size[]
  styles Style[]
}

// 개별 사이즈. sortOrder로 정렬해야 "95, 100, 105" 순서가 보장됩니다.
// (문자열로 정렬하면 "100, 105, 95"가 됨)
model Size {
  id          Int    @id @default(autoincrement())
  sizeGroupId Int
  code        String // 100
  label       String // 100 (L)
  sortOrder   Int

  sizeGroup    SizeGroup         @relation(fields: [sizeGroupId], references: [id])
  skus         Sku[]
  measurements SizeMeasurement[]
  modelWears   ModelWear[]

  @@unique([sizeGroupId, code])
  @@unique([sizeGroupId, sortOrder]) // 같은 체계 안에서 정렬 순서 중복 금지
}

// 소재 마스터: "울", "WOOL", "양모"가 따로 생기지 않게 이름을 통일합니다.
model Material {
  id        Int          @id @default(autoincrement())
  code      String       @unique // WOOL
  name      String // 울
  nameEn    String // Wool
  kind      MaterialKind // 천연 / 합성 / 재생 / 가죽
  sortOrder Int          @default(0)

  styleMaterials StyleMaterial[]
}

// 제조사·수입사 마스터 (상품정보제공고시의 "제조자(수입자)", 생산 협력사 관리)
model Manufacturer {
  id           Int              @id @default(autoincrement())
  code         String           @unique // MYSHOP
  name         String // (주)마이샵
  role         ManufacturerRole
  country      String // 회사 소재 국가 (제조국과 다를 수 있음)
  contactPhone String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())

  styles Style[]
}

// 세탁 기호 마스터: 아이콘 + 설명
model CareSymbol {
  id        Int          @id @default(autoincrement())
  code      String       @unique // HAND_WASH_30
  category  CareCategory
  name      String // 30℃ 손세탁
  icon      String // 화면 표시용 아이콘 (나중에 이미지 주소로 교체 가능)
  sortOrder Int          @default(0)

  styles StyleCare[]
}

// ---------- 핵심 3단 구조 ----------

// 스타일 = 우리가 흔히 "상품"이라고 부르는 단위. 상세페이지 1개, 리뷰도 여기에 모입니다.
model Style {
  id             Int     @id @default(autoincrement())
  styleCode      String  @unique // JK26F001 (품번, URL에도 사용)
  name           String // 울 블렌드 싱글 자켓
  summary        String? // 한 줄 소개 (목록·공유용)
  description    String // 상세 설명
  gender         Gender
  categoryId     Int
  seasonId       Int?
  sizeGroupId    Int // 이 스타일이 쓰는 사이즈 체계
  manufacturerId Int? // 제조사·수입사

  // 구매·판매 조건
  maxQtyPerOrder   Int? // 1회 주문 최대 수량 (한정 상품). 없으면 제한 없음
  preorderShipDate DateTime? // 예약 판매 출고 예정일. 있으면 "예약 판매" 상품

  // 검색엔진(SEO)용. 비어 있으면 name / summary를 대신 씁니다.
  metaTitle       String?
  metaDescription String?

  // 가격은 Style에 두지 않습니다.
  // 정가 → StylePrice(이력), 판매가 → 정가 + 할인 행사(PricePromotion)로 계산 (lib/pricing.ts)

  // 패션 속성: 필터·상세 표시용이라 정식 컬럼으로 둡니다.
  fit       Fit?
  thickness Level3? // 두께감
  stretch   Level3? // 신축성
  sheerness Level3? // 비침
  lining    Lining? // 안감

  // 판매 상태와 전시 여부는 분리 (판매 중이지만 숨겨둘 수 있음)
  status      StyleStatus @default(DRAFT)
  isDisplayed Boolean     @default(false)
  releasedAt  DateTime? // 출시일 (NEW 판단 기준)
  saleStartAt DateTime? // 예약 오픈
  saleEndAt   DateTime?

  deletedAt DateTime? // 소프트 삭제 (주문이 참조하므로 실제로 지우지 않음)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  category         Category               @relation(fields: [categoryId], references: [id])
  season           Season?                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  sizeGroup        SizeGroup              @relation(fields: [sizeGroupId], references: [id])
  manufacturer     Manufacturer?          @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  colors           StyleColor[]
  materials        StyleMaterial[]
  measurements     SizeMeasurement[]
  modelWears       ModelWear[]
  notice           StyleNotice?
  cares            StyleCare[]
  wearSeasons      StyleWearSeason[]
  detailBlocks     StyleDetailBlock[]
  prices           StylePrice[]
  promotionTargets PricePromotionTarget[]

  @@index([categoryId])
  @@index([status, isDisplayed])
}

// 스타일 × 컬러 (컬러웨이). 사진·품절·출시일이 컬러마다 다르기 때문에 독립 단위입니다.
// 정렬 순서가 가장 앞인 컬러가 "대표 컬러"가 됩니다.
model StyleColor {
  id          Int        @id @default(autoincrement())
  styleId     Int
  colorId     Int
  code        String     @unique // JK26F001-BK
  colorLabel  String? // 마케팅 컬러명 (예: "딥 블랙"). 없으면 Color.name 사용
  status      SaleStatus @default(ON_SALE)
  isDisplayed Boolean    @default(true)
  releasedAt  DateTime? // 컬러 추가 출시일 (나중에 나온 컬러)
  sortOrder   Int        @default(0)

  style      Style             @relation(fields: [styleId], references: [id])
  color      Color             @relation(fields: [colorId], references: [id])
  skus       Sku[]
  images     StyleColorImage[]
  modelWears ModelWear[]

  @@unique([styleId, colorId]) // 같은 스타일에 같은 컬러 중복 금지
  @@unique([styleId, sortOrder]) // 정렬 순서 중복 금지 → "0번 = 대표 컬러"가 항상 1개
}

// SKU (Stock Keeping Unit) = 컬러 × 사이즈. 재고·장바구니·주문의 실제 단위
model Sku {
  id           Int        @id @default(autoincrement())
  styleColorId Int
  sizeId       Int
  skuCode      String     @unique // JK26F001-BK-100
  barcode      String?    @unique // 바코드 (매장 POS·물류용)
  status       SaleStatus @default(ON_SALE)
  // 재고는 Sku에 두지 않습니다 → InventoryBalance(위치별 잔고) / InventoryLedger(원장) / InventoryReservation(예약)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  styleColor   StyleColor             @relation(fields: [styleColorId], references: [id])
  size         Size                   @relation(fields: [sizeId], references: [id])
  orderItems   OrderItem[]
  balances     InventoryBalance[]
  ledgers      InventoryLedger[]
  reservations InventoryReservation[]

  @@unique([styleColorId, sizeId]) // 같은 컬러에 같은 사이즈 중복 금지
}

// ---------- 상세 정보 ----------

// 컬러별 이미지. 컬러칩을 누르면 이 컬러의 이미지로 바뀝니다.
// 파일은 저장소(CDN)에 두고 DB에는 주소만 저장합니다.
model StyleColorImage {
  id           Int       @id @default(autoincrement())
  styleColorId Int
  url          String
  type         ImageType
  alt          String // 대체 텍스트 (접근성·SEO)
  sortOrder    Int       @default(0)

  styleColor StyleColor @relation(fields: [styleColorId], references: [id], onDelete: Cascade)

  @@index([styleColorId, sortOrder])
}

// 혼용률: 겉감 울 70% / 폴리에스터 30%, 안감 폴리에스터 100%
model StyleMaterial {
  id         Int    @id @default(autoincrement())
  styleId    Int
  part       String // 겉감 / 안감 / 배색 / 충전재
  materialId Int // 소재 마스터 (글자로 직접 쓰지 않음)
  percent    Int // 70  (같은 part의 합은 100)
  sortOrder  Int    @default(0)

  style    Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@index([styleId])
  @@index([materialId]) // "울이 들어간 상품" 찾기용
}

// 스타일 × 세탁 기호 (N:M 매핑)
model StyleCare {
  styleId      Int
  careSymbolId Int
  sortOrder    Int @default(0)

  style      Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)
  careSymbol CareSymbol @relation(fields: [careSymbolId], references: [id])

  @@id([styleId, careSymbolId]) // 같은 기호 중복 금지
}

// 스타일 × 착용 계절 (N:M). 값이 4개로 고정이라 마스터 테이블 대신 enum을 씁니다.
model StyleWearSeason {
  styleId Int
  season  WearSeason

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([styleId, season])
  @@index([season]) // "가을에 입는 상품" 필터용
}

// 상세페이지 콘텐츠 블록: 텍스트·이미지·영상을 순서대로 쌓아 상세페이지를 만듭니다.
// 통이미지 한 장보다 수정이 쉽고, 텍스트가 검색엔진에 읽힙니다.
model StyleDetailBlock {
  id        Int             @id @default(autoincrement())
  styleId   Int
  type      DetailBlockType
  title     String? // TEXT: 소제목
  body      String? // TEXT: 본문 / IMAGE: 캡션
  mediaUrl  String? // IMAGE·VIDEO: 주소
  alt       String? // IMAGE: 대체 텍스트
  sortOrder Int             @default(0)
  isVisible Boolean         @default(true)

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId, sortOrder])
}

// 사이즈별 실측 (스타일 × 사이즈 × 항목 = cm). 실측표를 자동으로 만들 수 있습니다.
model SizeMeasurement {
  id      Int         @id @default(autoincrement())
  styleId Int
  sizeId  Int
  item    MeasureItem
  valueCm Float // 52.5

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)
  size  Size  @relation(fields: [sizeId], references: [id])

  @@unique([styleId, sizeId, item])
}

// 모델 착용 정보: "모델 183cm / 72kg, 100 사이즈 착용"
model ModelWear {
  id           Int     @id @default(autoincrement())
  styleId      Int
  styleColorId Int? // 어떤 컬러를 입었는지 (선택)
  sizeId       Int // 착용 사이즈
  modelName    String?
  heightCm     Int
  weightKg     Int?
  note         String? // "평소 100 착용, 여유 있게 입음"

  style      Style       @relation(fields: [styleId], references: [id], onDelete: Cascade)
  styleColor StyleColor? @relation(fields: [styleColorId], references: [id], onDelete: SetNull) // 컬러가 지워지면 "컬러 정보 없음"으로 (의도된 SetNull)
  size       Size        @relation(fields: [sizeId], references: [id])

  @@index([styleId])
}

// 상품정보제공고시 (전자상거래법 의무). 품목군마다 항목이 달라서 JSON으로 저장합니다.
// 검색·필터에 쓰지 않는 "보여주기만 하는" 정보라 JSON이 적합합니다.
model StyleNotice {
  styleId    Int        @id // 스타일과 1:1
  noticeType NoticeType
  content    Json // [{ "label": "제조국", "value": "대한민국" }, ...]
  updatedAt  DateTime   @updatedAt

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)
}

// ===============================================================
// 가격 도메인 (C안: 정가 이력 + 할인 행사 규칙 분리)
//
//   판매가 = 정가(StylePrice, 지금 유효한 행)
//          − 지금 적용 가능한 할인 행사(PricePromotion) 중 할인이 가장 큰 1개
//   판매가는 저장하지 않고 계산합니다 (lib/pricing.ts).
//   → 행사 시작·종료가 시각에 맞춰 자동으로 반영됩니다.
// ===============================================================

// 정가 변경 사유
enum PriceChangeReason {
  INITIAL // 최초 등록
  REPRICE // 정책상 가격 조정 (시즌 재책정 등)
  COST_CHANGE // 원가 변동 (원자재·환율)
  ERROR_FIX // 잘못 입력한 가격 정정
}

// 할인 방식
enum DiscountType {
  RATE // 정률: 정가의 N% 할인
  AMOUNT // 정액: N원 할인
  FIXED_PRICE // 균일가: N원에 판매 (예: 전 품목 39,000원)
}

// 행사 상태. "예정 / 진행 중 / 종료"는 저장하지 않고 기간(startAt~endAt)으로 계산합니다.
// (품절을 재고로 계산하는 것과 같은 원리: 사람이 상태를 바꾸지 않아도 시각에 맞춰 바뀜)
enum PromotionStatus {
  DRAFT // 작성 중 (적용 안 됨)
  APPROVED // 확정. 기간 안이면 자동 적용
  PAUSED // 일시 중지 (가격 오류 등 긴급 상황)
  CANCELED // 취소 (기록은 남김)
}

// 할인 대상 종류
enum PromotionTargetType {
  ALL // 전체 상품
  CATEGORY // 카테고리 (하위 카테고리 포함)
  SEASON // 시즌 (26SS 시즌오프)
  GENDER // 성별 (남성 전체)
  STYLE // 특정 스타일
}

// 포함 / 제외
enum TargetMode {
  INCLUDE
  EXCLUDE // "전체 30%, 단 신상은 제외"
}

// 끝자리 처리 방식
enum RoundingMode {
  FLOOR // 내림 (고객에게 유리, 가장 흔함)
  ROUND // 반올림
  CEIL // 올림
}

// 정가 이력 (SCD Type 2: 덮어쓰지 않고 기간이 있는 행을 계속 추가)
// 지금 정가 = validFrom <= 지금 < validTo (validTo가 비어 있으면 현재 적용 중)
// 할인율을 표시하려면 "할인 전 가격에 실제로 팔았던 근거"가 필요해서, 이 이력이 법적 근거가 됩니다.
model StylePrice {
  id        Int               @id @default(autoincrement())
  styleId   Int
  listPrice Int // 정가 (택가, 부가세 포함)
  currency  String            @default("KRW") // 통화 (해외몰 대비)
  validFrom DateTime // 적용 시작
  validTo   DateTime? // 적용 종료 (null = 현재 가격)
  reason    PriceChangeReason
  memo      String? // "원단 단가 8% 인상 반영"
  changedBy String? // 변경한 관리자 (관리자 단계에서 FK로 연결)
  createdAt DateTime          @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Restrict) // 가격 이력은 법적 근거라 함께 지우지 않음

  @@index([styleId, validFrom]) // "이 스타일의 지금 가격" 조회용
}

// 할인 행사: 행사 1개 = 규칙 1개. 대상 상품이 300개여도 행은 1개입니다.
model PricePromotion {
  id          Int     @id @default(autoincrement())
  code        String  @unique // 26SS_SEASON_OFF (내부 관리 코드)
  name        String // 26SS 시즌오프 (관리자용 이름)
  displayName String // 시즌오프 (고객에게 보이는 이름, 주문 내역 표시)
  description String? // 행사 설명 (관리자 메모)

  // 할인 규칙
  discountType      DiscountType
  discountValue     Int // RATE: 30(%) / AMOUNT: 10000(원) / FIXED_PRICE: 39000(원)
  maxDiscountAmount Int? // 정률 할인의 최대 할인 금액 (예: 최대 3만원까지)
  minListPrice      Int? // 정가 N원 이상 상품에만 적용
  roundingUnit      Int          @default(100) // 판매가 끝자리 단위 (10 / 100 / 1000원)
  roundingMode      RoundingMode @default(FLOOR)

  // 기간과 상태
  startAt  DateTime
  endAt    DateTime // 이 시각 직전까지 적용 (startAt <= 지금 < endAt)
  status   PromotionStatus @default(DRAFT)
  priority Int             @default(0) // 할인액이 같을 때 높은 쪽 우선

  // 화면 표시
  badgeText   String? // 상품 카드 뱃지 "SEASON OFF"
  showEndDate Boolean @default(false) // 상세에 "~11/30 종료" 표시

  // 관리 정보 (관리자 단계에서 FK로 연결)
  createdBy  String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  targets    PricePromotionTarget[]
  orderItems OrderItem[]

  @@index([status, startAt, endAt]) // "지금 진행 중인 행사" 조회용
}

// 할인 대상: 어떤 상품에 적용하나 (포함 / 제외)
// targetType에 맞는 컬럼 하나만 채웁니다. (ALL이면 전부 비움)
// 범용 targetId 하나 대신 FK 컬럼을 따로 두어서, 없는 카테고리·스타일을 가리키지 못하게 DB가 막아 줍니다.
model PricePromotionTarget {
  id          Int                 @id @default(autoincrement())
  promotionId Int
  targetType  PromotionTargetType
  mode        TargetMode          @default(INCLUDE)

  categoryId Int? // CATEGORY: 이 카테고리와 그 하위 전부
  seasonId   Int? // SEASON
  gender     Gender? // GENDER
  styleId    Int? // STYLE

  // 이 대상에만 다른 할인값 적용 (예: 전체 30%인데 아우터만 40%). 비어 있으면 행사 기본값
  discountValueOverride Int?
  createdAt             DateTime @default(now())

  promotion PricePromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  // 대상이 가리키는 카테고리·시즌·스타일은 삭제 거부. (SetNull이면 "스니커즈 제외" 행이 조용히 무력화되어 제외 상품에 할인이 붙음)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  season    Season?        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  style     Style?         @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@index([promotionId])
  @@index([styleId])
  @@index([categoryId])
}

// ===============================================================
// 재고 도메인 (B안: 주문 시 예약 → 결제 시 확정 → 시간 초과 시 해제)
//
//   InventoryLocation   재고 위치 (온라인 물류센터, 매장, 반품센터, 불량창고)
//   InventoryBalance    SKU × 위치별 "지금 수량" (실재고·예약·안전재고) — 앱이 직접 고치지 않음
//   InventoryLedger     재고 원장 (입고·판매·반품·조정…) — 추가만 가능, 합계 = 실재고
//   InventoryReservation 결제 대기 중인 예약 — RESERVED → CONFIRMED / RELEASED / EXPIRED
//
//   판매 가능 수량 = 실재고(onHand) − 예약(reserved) − 안전재고(safetyStock)
//
// ⚠️ 잔고(onHand, reserved)는 DB 트리거가 원장·예약에서 자동으로 맞춥니다(prisma/db-constraints.ts).
//    앱은 원장 행 추가 / 예약 행 추가·상태 변경만 합니다. 그래서 "원장 합계 = 실재고"가 DB에서 보장됩니다.
// ===============================================================

// 재고 위치 종류
enum LocationType {
  WAREHOUSE // 물류센터 (온라인 출고)
  STORE // 오프라인 매장 (⑲ 단계에서 사용)
  RETURN_CENTER // 반품 검수센터 (검수 전 재고, 판매 불가)
  DEFECT // 불량 창고 (판매 불가)
}

// 원장 유형. 유형마다 수량의 부호가 정해져 있습니다 (CHECK로 강제).
enum LedgerType {
  INITIAL // + 시스템 도입 시 기초 재고
  INBOUND // + 입고 (생산·발주)
  RETURN_IN // + 반품 입고 (검수 완료)
  ADJUST_IN // + 실사 조정 (시스템보다 실물이 많음)
  TRANSFER_IN // + 위치 이동 입고
  SALE // − 판매 출고 확정 (결제 승인 시 예약 확정에서 자동 생성)
  ADJUST_OUT // − 실사 조정 (분실 등, 시스템보다 실물이 적음)
  DEFECT_OUT // − 불량 처리
  TRANSFER_OUT // − 위치 이동 출고
}

// 원장이 무엇 때문에 생겼는지
enum LedgerRefType {
  ORDER // 주문 (refId = 주문 id)
  RETURN // 반품 (⑩ 클레임 단계)
  INBOUND_ORDER // 입고 문서 (발주·생산 오더 번호)
  STOCK_COUNT // 재고 실사
  TRANSFER // 위치 이동 (나가는 행·들어오는 행이 같은 refId)
  MANUAL // 관리자 수동 처리 (사유 필수)
  MIGRATION // 시스템 이전 (Sku.stock → 원장)
}

// 예약 상태: RESERVED에서 한 번만 바뀝니다.
enum ReservationStatus {
  RESERVED // 결제 대기 중 (판매 가능 수량에서 빠져 있음)
  CONFIRMED // 결제 승인 → 판매 확정 (원장 SALE 생성)
  RELEASED // 해제 (결제 실패·이탈·새 주문으로 대체 등)
  EXPIRED // 만료 (유효 시간 초과)
}

// 예약 해제 사유
enum ReleaseReason {
  PAYMENT_FAILED // 결제 실패·결제창 취소
  SUPERSEDED // 같은 고객이 새 주문을 만들어 이전 결제 대기 주문을 대체
  PRICE_CHANGED // 결제 직전 가격 변경으로 중단
  COMPENSATED // 결제 승인 후 저장 실패 → 결제 취소(보상)
  RENEWED // 결제 승인 직전 만료가 임박해서 새 예약으로 갱신
  ADMIN // 관리자 처리
}

// 재고 위치
model InventoryLocation {
  id               Int          @id @default(autoincrement())
  code             String       @unique // ONLINE_DC
  name             String // 온라인 물류센터 (이천)
  type             LocationType
  isOnlineSellable Boolean      @default(false) // 온라인 주문에 재고를 쓸 수 있는 위치인가
  isActive         Boolean      @default(true)
  priority         Int          @default(0) // 여러 위치에 재고가 있을 때 먼저 쓰는 순서 (작을수록 먼저)
  address          String?
  contactPhone     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  balances     InventoryBalance[]
  ledgers      InventoryLedger[]
  reservations InventoryReservation[]
}

// 위치별 재고 잔고 ("지금 몇 개")
// 행은 0으로만 만들 수 있고, onHand·reserved는 트리거만 바꿀 수 있습니다.
model InventoryBalance {
  skuId         Int
  locationId    Int
  onHand        Int       @default(0) // 실재고: 창고에 실제로 있는 수량 (= 원장 합계)
  reserved      Int       @default(0) // 예약: 결제 대기 중인 수량 (= RESERVED 예약 합계)
  safetyStock   Int       @default(0) // 안전재고: 오차 대비로 팔지 않고 남겨 두는 수량
  lastCountedAt DateTime? // 마지막 실사 일시
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) // 트리거·앱이 갱신

  sku      Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([skuId, locationId])
  @@index([locationId])
}

// 재고 원장: 재고가 바뀐 모든 이유를 한 줄씩 기록 (추가만 가능 — 수정·삭제 금지)
// 실재고 = 이 테이블 qty의 합계. 잘못 넣었으면 지우지 말고 반대 방향 행을 추가합니다.
model InventoryLedger {
  id            Int           @id @default(autoincrement())
  skuId         Int
  locationId    Int
  type          LedgerType
  qty           Int // 변동 수량 (입고 +10, 판매 −1)
  balanceAfter  Int // 반영 후 실재고 (트리거가 "직전 실재고 + qty"와 같은지 검사)
  refType       LedgerRefType
  refId         String? // 참조 번호 (주문 id, 입고 문서 번호 PO-2611-001 등)
  reservationId Int? // SALE이면 어떤 예약이 확정된 것인지
  reason        String? // 조정·불량·수동 처리 사유 (해당 유형은 필수)
  memo          String?
  createdBy     String? // 처리자 (관리자 단계에서 FK로 연결, 시스템 처리는 SYSTEM)
  occurredAt    DateTime // 실제로 일어난 시각 (실사일, 입고일)
  createdAt     DateTime      @default(now()) // 기록한 시각

  sku         Sku                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location    InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([skuId, locationId, id]) // 잔고 재계산·이력 조회
  @@index([refType, refId])
  @@index([reservationId])
}

// 재고 예약: 주문을 만들 때 잡고, 결제되면 확정, 아니면 해제·만료
model InventoryReservation {
  id            Int               @id @default(autoincrement())
  orderId       Int
  skuId         Int
  locationId    Int
  qty           Int
  status        ReservationStatus @default(RESERVED)
  expiresAt     DateTime // 이 시각까지 결제하지 않으면 만료
  confirmedAt   DateTime?
  releasedAt    DateTime? // 해제·만료된 시각
  releaseReason ReleaseReason? // 해제 사유 (만료는 상태로 구분하므로 비워 둠)
  createdAt     DateTime          @default(now())

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sku      Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  ledgers  InventoryLedger[]

  @@index([skuId, locationId, status]) // 예약 합계 계산
  @@index([orderId])
  @@index([status, expiresAt]) // 만료 대상 찾기
}

// ===============================================================
// 고객 도메인 (B안: 로그인 계정 User와 쇼핑몰 고객 Customer 분리)
//
//   User (Auth.js 로그인 계정) ──1:1── Customer (고객번호·상태·등급)
//                                        ├─ CustomerProfile      개인정보 (AES-256-GCM 암호화)
//                                        ├─ CustomerBodyProfile  체형 정보 (선택)
//                                        ├─ CustomerAddress      배송지 N개 (암호화)
//                                        ├─ CustomerStatusHistory 상태 이력 (트리거가 자동 기록)
//                                        ├─ CustomerGradeHistory  등급 이력
//                                        ├─ CustomerWithdrawal    탈퇴 신청·처리
//                                        └─ CustomerLoginHistory  로그인 기록 (3개월 보관)
//
// 탈퇴: 신청 → 7일 유예(철회 가능) → 개인정보 익명화 + User 삭제. Customer와 주문은 남음(전자상거래법 5년 보관).
// 개인정보 암호문 형식: "v1:<IV>:<인증태그>:<암호문>" (base64). 키는 .env의 CUSTOMER_ENC_KEY (lib/crypto.ts)
// ===============================================================

// 고객 상태
enum CustomerStatus {
  ACTIVE // 정상
  DORMANT // 휴면 (1년 미접속. 분리 보관 의무는 2023.9 폐지 → 상태 표시만)
  SUSPENDED // 이용 정지 (부정 이용)
  WITHDRAW_PENDING // 탈퇴 신청 (7일 유예, 철회 가능)
  WITHDRAWN // 탈퇴 완료 (익명화, 되돌릴 수 없음)
}

// 상태 변경 사유 (이력에 남음)
enum CustomerStatusReason {
  SIGNUP // 가입
  LOGIN // 휴면 고객이 다시 로그인
  INACTIVITY // 장기 미접속으로 휴면 전환
  ABUSE // 부정 이용으로 정지
  APPEAL // 정지 해제
  WITHDRAW_REQUEST // 탈퇴 신청
  WITHDRAW_CANCEL // 탈퇴 철회
  WITHDRAW_COMPLETE // 탈퇴 완료
  ADMIN // 관리자 처리
}

// 가입 경로
enum JoinChannel {
  WEB
  APP
  STORE // 매장 가입 (로그인 계정이 없을 수 있음)
  IMPORT // 데이터 이전
}

// 고객 성별 (상품의 Gender와 별개: 고객은 밝히지 않을 수 있음)
enum CustomerGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

// 탈퇴 사유
enum WithdrawalReason {
  LOW_USAGE // 이용 빈도 낮음
  PRIVACY // 개인정보 우려
  PRODUCT // 상품 불만
  DELIVERY // 배송 불만
  SERVICE // 서비스·응대 불만
  REJOIN // 재가입 목적
  OTHER
}

// 등급 변경 사유
enum GradeChangeReason {
  SIGNUP // 가입 시 기본 등급
  PERIODIC // 정기 산정 (최근 12개월 구매 금액)
  ADMIN // 관리자 조정
}

// 로그인 결과
enum LoginResult {
  SUCCESS
  BLOCKED_SUSPENDED // 정지 회원 차단
}

// 쇼핑몰 고객
model Customer {
  id          Int            @id @default(autoincrement())
  customerNo  String         @unique // C + 숫자 10자리 (외부 노출용. 순번이 아니라 무작위 → 다른 고객 번호 추측 방지)
  userId      String?        @unique // 로그인 계정. 탈퇴하면 비움. 매장 가입 고객은 없을 수 있음
  status      CustomerStatus @default(ACTIVE)
  gradeId     Int // 현재 등급 (바꾸려면 등급 이력을 먼저 추가)
  joinChannel JoinChannel    @default(WEB)
  joinedAt    DateTime       @default(now())
  lastLoginAt DateTime?
  lastOrderAt DateTime? // 마지막 결제 완료 시각 (휴면·등급 산정 참고)

  // 상태 변경 정보: 상태를 바꿀 때 함께 바꾸고, 트리거가 이 값으로 상태 이력을 남깁니다.
  statusReason    CustomerStatusReason
  statusMemo      String?
  statusChangedBy String? // 처리자 (SYSTEM / 관리자)
  statusChangedAt DateTime

  dormantAt       DateTime? // 휴면 전환 시각
  suspendedAt     DateTime? // 정지 시각
  suspendedReason String?
  withdrawnAt     DateTime? // 탈퇴 완료 시각
  anonymizedAt    DateTime? // 개인정보 익명화 시각

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  grade         CustomerGrade           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  profile       CustomerProfile?
  bodyProfile   CustomerBodyProfile?
  addresses     CustomerAddress[]
  statusHistory CustomerStatusHistory[]
  gradeHistory  CustomerGradeHistory[]
  withdrawals   CustomerWithdrawal[]
  loginHistory  CustomerLoginHistory[]
  orders        Order[]

  @@index([status])
  @@index([gradeId])
  @@index([lastLoginAt]) // 휴면 대상 찾기
}

// 개인정보 (1:1, 암호화). 화면에는 마스킹해서 보여 줍니다 (홍*동, 010-****-5678)
model CustomerProfile {
  customerId      Int            @id
  nameEnc         String? // 이름 암호문
  phoneEnc        String? // 휴대폰 암호문
  phoneHash       String? // 휴대폰 검색용 HMAC (블라인드 인덱스). 중복 가입 확인·전화번호로 찾기
  birthDateEnc    String? // 생년월일 암호문 (YYYY-MM-DD)
  birthMonth      Int? // 생일 월 (생일 쿠폰용, 평문. 월만으로는 개인 식별 불가)
  gender          CustomerGender @default(UNDISCLOSED)
  contactEmailEnc String? // 연락용 이메일 암호문 (로그인 이메일과 다를 수 있음)
  emailHash       String? // 연락용 이메일 검색용 HMAC
  updatedAt       DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([phoneHash])
  @@index([emailHash])
}

// 체형 정보 (1:1, 모두 선택). 사이즈 추천·리뷰의 "구매자 체형"에 사용
model CustomerBodyProfile {
  customerId    Int      @id
  heightCm      Int?
  weightKg      Int?
  topSize       String? // 평소 상의 사이즈 (95, M ...)
  bottomSize    String? // 평소 하의 사이즈 (30 ...)
  shoeSizeMm    Int? // 평소 신발 사이즈 (270)
  preferredFit  Fit? // 선호 핏
  showInReviews Boolean  @default(false) // 리뷰에 체형 공개 동의 (기본 비공개)
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
}

// 배송지 (N개, 암호화). 주문에는 배송지 "스냅샷"을 복사하므로 주소록은 지워도 됨 (⑦ 주문 단계)
model CustomerAddress {
  id           Int       @id @default(autoincrement())
  customerId   Int
  label        String // 집 / 회사
  recipientEnc String // 수령인 암호문
  phoneEnc     String // 수령인 연락처 암호문
  zipCode      String // 우편번호 5자리 (평문: 단독으로는 개인 식별 불가, 배송비 산정에 사용)
  address1Enc  String // 기본 주소 암호문
  address2Enc  String? // 상세 주소 암호문
  deliveryMemo String? // 배송 요청 사항
  isDefault    Boolean   @default(false) // 기본 배송지 (고객당 최대 1개, 트리거)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
}

// 상태 변경 이력 (추가만 가능). Customer의 상태가 바뀌면 트리거가 자동으로 한 줄 추가
model CustomerStatusHistory {
  id         Int                  @id @default(autoincrement())
  customerId Int
  fromStatus CustomerStatus? // 가입 시 비어 있음
  toStatus   CustomerStatus
  reason     CustomerStatusReason
  memo       String?
  changedBy  String?
  changedAt  DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, id])
}

// 탈퇴 신청·처리
model CustomerWithdrawal {
  id               Int              @id @default(autoincrement())
  customerId       Int
  reasonCode       WithdrawalReason
  reasonText       String? // 직접 입력한 사유
  requestedAt      DateTime
  scheduledAt      DateTime // 처리 예정일 (신청 + 7일 이상). 이전에는 철회 가능
  completedAt      DateTime? // 처리 완료 (익명화)
  canceledAt       DateTime? // 철회
  rejoinBlockHash  String? // 재가입 악용 방지: 로그인 계정(제공자+계정ID)의 HMAC. 개인정보 아님
  rejoinBlockUntil DateTime? // 이 시각까지 같은 계정 재가입 제한 (완료 + 30일)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([rejoinBlockHash])
  @@index([scheduledAt]) // 처리 대상 찾기
}

// 회원 등급 마스터
model CustomerGrade {
  id          Int      @id @default(autoincrement())
  code        String   @unique // WELCOME / SILVER / GOLD / VIP
  name        String
  minAmount   Int      @unique // 최근 12개월 결제 금액 기준 (원). 기준이 겹치지 않게 UNIQUE
  pointRateBp Int // 포인트 적립률 (bp: 100 = 1%). ⑭ 포인트 단계에서 사용
  sortOrder   Int      @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers   Customer[]
  historyFrom CustomerGradeHistory[] @relation("GradeFrom")
  historyTo   CustomerGradeHistory[] @relation("GradeTo")
}

// 등급 변경 이력 (추가만 가능)
model CustomerGradeHistory {
  id             Int               @id @default(autoincrement())
  customerId     Int
  fromGradeId    Int? // 가입 시 비어 있음
  toGradeId      Int
  reason         GradeChangeReason
  purchaseAmount Int? // 산정에 쓴 결제 금액
  periodFrom     DateTime? // 산정 기간
  periodTo       DateTime?
  changedBy      String?
  changedAt      DateTime

  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fromGrade CustomerGrade? @relation("GradeFrom", fields: [fromGradeId], references: [id], onDelete: Restrict)
  toGrade   CustomerGrade  @relation("GradeTo", fields: [toGradeId], references: [id], onDelete: Restrict)

  @@index([customerId, id])
}

// 로그인 기록 (통신비밀보호법 접속기록 3개월 보관). 수정 금지, 3개월 지난 것만 삭제 가능
model CustomerLoginHistory {
  id         Int         @id @default(autoincrement())
  customerId Int
  provider   String // github
  result     LoginResult
  ipMasked   String? // 123.45.67.*  (마지막 자리 가림)
  userAgent  String?
  loggedInAt DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, loggedInAt])
  @@index([loggedInAt]) // 3개월 지난 기록 정리
}

// 주문 (5단계 결제에서 사용)
model Order {
  id             Int      @id @default(autoincrement())
  paymentOrderId String   @unique // 토스페이먼츠에 보내는 주문번호 (영문/숫자 6~64자)
  orderName      String // 결제창에 보이는 이름. 예: "러닝 스니커즈 외 2건"
  totalPrice     Int // 서버가 DB 가격으로 계산한 금액
  status         String   @default("PENDING") // PENDING(결제 대기) → PAID(결제 완료)
  paymentKey     String? // 결제 승인 후 토스가 준 결제 키 (환불할 때 필요)
  createdAt      DateTime @default(now())
  customerId     Int // 주문한 고객 (로그인 계정 User가 아니라 Customer를 가리킴 → 탈퇴해도 주문 기록은 남음)

  customer     Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  reservations InventoryReservation[]

  @@index([customerId, createdAt])
}

// 주문 안의 상품 한 줄 (어떤 주문에, 어떤 SKU를, 몇 개)
// 상품명·컬러·사이즈·가격은 "주문 당시 값"을 복사해 둡니다(스냅샷).
// 나중에 상품 이름이나 가격이 바뀌어도 주문 내역은 그대로 남아야 하기 때문입니다.
model OrderItem {
  id       Int @id @default(autoincrement())
  orderId  Int
  skuId    Int // 실제로 주문한 단위 (컬러 + 사이즈)
  quantity Int

  // 가격 스냅샷 (1개 기준): 정가 − 할인 = 판매가
  listPrice      Int // 주문 당시 정가
  discountAmount Int // 주문 당시 1개당 할인액
  price          Int // 주문 당시 1개 판매가 (= listPrice − discountAmount)
  promotionId    Int? // 적용된 할인 행사 (행사가 지워져도 주문은 남도록 SetNull)
  promotionName  String? // 스냅샷: 행사 이름이 나중에 바뀌어도 당시 이름 유지

  styleCode String // 스냅샷: JK26F001
  skuCode   String // 스냅샷: JK26F001-BK-100
  styleName String // 스냅샷: 울 블렌드 싱글 자켓
  colorName String // 스냅샷: 블랙
  sizeName  String // 스냅샷: 100
  imageUrl  String? // 스냅샷: 주문 당시 대표 이미지

  order     Order           @relation(fields: [orderId], references: [id])
  sku       Sku             @relation(fields: [skuId], references: [id])
  promotion PricePromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([skuId])
}

// ---------------------------------------------------------------
// 로그인(Auth.js)용 표들. Auth.js가 정한 형태 그대로 써야 합니다.
// ---------------------------------------------------------------

// 회원
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String? // 프로필 사진 주소 (GitHub 아바타)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  customer Customer? // 쇼핑몰 고객 (1:1). 탈퇴하면 이 User는 삭제되고 Customer는 익명화되어 남음
}

// 어떤 외부 서비스(GitHub 등) 계정으로 로그인했는지
model Account {
  userId            String
  type              String
  provider          String // 예: "github"
  providerAccountId String // GitHub에서의 사용자 번호
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// 로그인 상태 (브라우저 쿠키에 sessionToken이 저장됩니다)
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 이메일 로그인용 (지금은 사용하지 않지만 Auth.js 어댑터가 요구합니다)
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
