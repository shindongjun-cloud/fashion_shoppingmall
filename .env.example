# .env 만드는 법 (이 파일을 복사해서 .env로 이름을 바꾸고 값을 채웁니다)
# ⚠️ 진짜 값은 절대 이 파일·Git·채팅·메신저에 넣지 마세요. .env는 Git에 올라가지 않습니다.
# 집·학원 등 컴퓨터마다 .env를 새로 만들어도 됩니다 (DB도 그 컴퓨터에서 새로 만든다면).

# DB 파일 위치 (그대로 사용)
DATABASE_URL="file:./dev.db"

# 로그인(Auth.js) 세션 서명용 비밀값. 새로 만들기:
#   npx auth secret   또는   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# GitHub 로그인: GitHub → Settings → Developer settings → OAuth Apps → 이 프로젝트 앱
#   Client ID는 화면에 보임. Client secret은 다시 볼 수 없으므로 "Generate a new client secret"으로 새로 발급
#   (기존 비밀키도 계속 동작: GitHub은 비밀키를 2개까지 허용)
#   콜백 주소(Authorization callback URL): http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 토스페이먼츠 테스트 키: 토스페이먼츠 개발자센터 문서에 공개된 "문서 테스트 키" (test_gck_docs_… / test_gsk_docs_…)
#   클라이언트 키(NEXT_PUBLIC_)와 시크릿 키는 같은 쌍이어야 함. live_ 키는 넣지 말 것
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# 고객 개인정보 암호화 키(AES-256) / 조회용 해시 키(HMAC). 각각 32바이트 base64, 둘은 서로 다른 값으로 새로 만들기:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 키를 잃으면 그 DB의 암호화된 개인정보(이름·연락처·주소)를 읽을 수 없음. 키와 dev.db는 항상 짝으로 다룸
CUSTOMER_ENC_KEY=""
CUSTOMER_HASH_KEY=""
