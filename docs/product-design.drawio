  <diagram id="d316" name="2. 상품 판매 상태 전이도">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p_start" value="" style="html=1;whiteSpace=wrap;fontSize=12;ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="395" y="20" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="p_draft" value="DRAFT&#xa;(작성 중)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="90" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="p_pend" value="PENDING_APPROVAL&#xa;(검수 대기)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="220" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="p_rej" value="REJECTED&#xa;(반려)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="p_sale" value="ON_SALE&#xa;(판매 중)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="380" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="p_sold" value="SOLD_OUT&#xa;(품절)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="p_stop" value="STOPPED&#xa;(판매 중지)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="540" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="p_disc" value="DISCONTINUED&#xa;(판매 종료)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="700" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="p_end" value="" style="html=1;whiteSpace=wrap;fontSize=12;ellipse;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="395" y="830" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="p_note1" value="판매 상태와 전시 여부(is_displayed)는 별개&#xa;· ON_SALE + 비전시 = 링크로만 판매&#xa;· sale_start_at 전에는 판매 예정으로 노출" style="html=1;whiteSpace=wrap;fontSize=12;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="p_note2" value="물리 삭제 금지&#xa;주문(order_item)이 참조하므로&#xa;상태만 바꾸고 deleted_at 기록" style="html=1;whiteSpace=wrap;fontSize=12;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="e301" value="상품 등록" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_start" target="p_draft"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e302" value="검수 요청&#xa;(입점형 몰)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_draft" target="p_pend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e303" value="반려&#xa;(reject_reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.3;" edge="1" parent="1" source="p_pend" target="p_rej"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e304" value="수정 후 재요청" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="p_rej" target="p_pend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e305" value="승인&#xa;(직매입 몰은 바로 판매)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_pend" target="p_sale"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e306" value="가용 재고 0&#xa;(자동)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.3;entryY=0;" edge="1" parent="1" source="p_sale" target="p_sold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e307" value="입고&#xa;(재입고 알림 발송)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0;entryY=0.8;" edge="1" parent="1" source="p_sold" target="p_sale"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e308" value="관리자 판매 중지&#xa;(가격 오류·법적 이슈)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.7;entryY=0;" edge="1" parent="1" source="p_sale" target="p_stop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e309" value="판매 재개" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="p_stop" target="p_sale"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e310" value="판매 종료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_sale" target="p_disc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e311" value="단종" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p_sold" target="p_disc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e312" value="판매 종료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p_stop" target="p_disc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e313" value="복구 불가&#xa;(주문 내역에는 계속 표시)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_disc" target="p_end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e314" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;" edge="1" parent="1" source="p_note1" target="p_sale"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e315" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;" edge="1" parent="1" source="p_note2" target="p_disc"><mxGeometry relative="1" as="geometry"/></mxCell>
