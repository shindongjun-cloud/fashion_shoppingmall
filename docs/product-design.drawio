  <diagram id="d329" name="3. 재고 예약·차감 흐름">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="A" value="고객: 주문하기 (결제 버튼)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="B" value="서버: 가격·재고 검증&#xa;(DB 가격으로 금액 계산)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="C" value="가용 재고 ≥ 수량?&#xa;(on_hand − reserved)" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="C1" value="품절 안내&#xa;(재입고 알림 신청 유도)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="D" value="재고 예약 (하나의 트랜잭션)&#xa;UPDATE inventory SET reserved = reserved + qty&#xa;WHERE sku_id = ? AND on_hand - reserved &gt;= qty&#xa;→ 영향받은 행 0이면 품절 처리&#xa;inventory_reservation 생성 (expires_at = +15분)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="340" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="E" value="주문 PENDING 생성 → 결제창" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="490" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="F" value="결제 결과?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="580" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="G" value="재고 확정 (결제 승인 시)&#xa;on_hand −= qty, reserved −= qty&#xa;reservation = CONFIRMED&#xa;inventory_transaction (ORDER, −qty)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="720" width="400" height="90" as="geometry"/></mxCell>
