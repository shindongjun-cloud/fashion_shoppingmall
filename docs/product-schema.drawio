        <mxCell id="h362" value="판매가 계산 흐름 (lib/pricing.ts)" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="h363" value="판매가는 저장하지 않고 화면을 열 때·주문할 때마다 계산 → 행사 시작·종료가 자동 반영" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="a" value="상품 목록 / 상세 / 장바구니 / 주문 생성" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="b" value="① 정가 찾기 (StylePrice)&#xa;validFrom ≤ 지금 &lt; validTo (null = 현재)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="b2" value="정가 없음 → 판매 불가 (목록 제외, 404)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="280" height="44" as="geometry"/></mxCell>
        <mxCell id="c1" value="② 진행 중 행사 찾기 (PricePromotion)&#xa;status = APPROVED 그리고 startAt ≤ 지금 &lt; endAt&#xa;(DRAFT·PAUSED·CANCELED, 기간 밖 → 제외)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="d" value="③ 행사마다 대상 판단&#xa;(PricePromotionTarget)" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="400" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="d2" value="EXCLUDE에 걸림 → 이 행사 제외&#xa;INCLUDE에 안 걸림 → 제외" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="425" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e" value="④ 할인액 계산&#xa;RATE: 정가 × (100 − N) ÷ 100  (정수 계산)&#xa;AMOUNT: 정가 − N / FIXED_PRICE: N원&#xa;→ 끝자리 처리(100원 내림) → 최대 할인 한도" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="550" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="f" value="⑤ 할인액이 가장 큰 행사 1개 선택&#xa;(같으면 priority 높은 것)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="380" height="56" as="geometry"/></mxCell>
        <mxCell id="g" value="판매가 = 정가 − 할인액&#xa;주문 시: 정가·할인액·행사명을 OrderItem에 스냅샷" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="776" width="380" height="56" as="geometry"/></mxCell>
        <mxCell id="e364" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e365" value="없음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e366" value="있음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e367" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e368" value="미해당" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e369" value="해당" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e370" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e371" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n372" value="예시: 셔츠 (정가 79,000 · 26SS · 상의&gt;셔츠)&#xa;&#xa;• 시즌오프 40% (최대 3만원) → 31,600 → 한도 30,000&#xa;• 데일리 특가 10% (상의 전체) → 7,900&#xa;• 니트 위크 → 대상 아님 (니트만)&#xa;→ 가장 큰 시즌오프 적용: 49,000원&#xa;&#xa;블프(예정)는 기간 전이라 아직 계산에 안 들어감.&#xa;시작 시각이 되면 아무도 손대지 않아도 적용됨." style="html=1;whiteSpace=wrap;fontSize=12;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="540" width="420" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d393" name="5. 재고 예약·확정 흐름">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h374" value="재고 흐름: 주문 시 예약 → 결제 시 확정 → 실패·이탈·시간 초과 시 해제" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="h375" value="앱은 원장·예약 '행'만 추가·변경 / 잔고 숫자는 DB 트리거가 맞춤 · lib/inventory.ts · lib/checkout.ts" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="f1" value="고객: 결제하기" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="110" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="f2" value="placeOrder (한 트랜잭션)&#xa;이전 결제 대기 주문 예약 해제(SUPERSEDED)&#xa;주문 + 항목 + 재고 예약(RESERVED, 20분)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="f2x" value="재고 부족 → 주문 안 만듦&#xa;'방금 다른 고객이 구매했어요'" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="f3" value="토스 결제창" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="140" y="285" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="f3x" value="결제창 취소·실패 → /api/payments/fail&#xa;예약 해제(PAYMENT_FAILED)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="280" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="f4" value="① ensureOrderReserved&#xa;만료됐거나 2분 안에 만료 → 다시 잡기(RENEWED)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="f4x" value="그 사이 재고 소진 → 토스 승인 요청 안 함&#xa;(고객 돈이 나가지 않음)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="363" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="f5" value="② 토스 결제 승인" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="140" y="450" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="f5x" value="승인 실패 → 예약 해제(PAYMENT_FAILED)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="450" width="280" height="44" as="geometry"/></mxCell>
        <mxCell id="f6" value="③ 주문 PAID + 예약 확정(CONFIRMED)&#xa;→ 트리거가 원장 SALE 생성 → 실재고 감소" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="f6x" value="③ 저장 실패 → 토스 결제 취소(보상)&#xa;주문 CANCELED, 예약 COMPENSATED&#xa;취소도 실패 → CANCEL_FAILED (사람 확인)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="500" y="525" width="280" height="66" as="geometry"/></mxCell>
        <mxCell id="f7" value="주문 완료" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="620" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="e376" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e377" value="부족" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f2" target="f2x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e378" value="예약 성공" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e379" value="취소" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3" target="f3x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e380" value="결제 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e381" value="재고 없음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4" target="f4x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e382" value="예약 유효" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e383" value="실패" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5" target="f5x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e384" value="성공" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e385" value="오류" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f6" target="f6x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e386" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s0" value="" style="html=1;whiteSpace=wrap;fontSize=12;ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="935" y="120" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="sR" value="RESERVED&#xa;결제 대기 (판매 가능에서 빠짐)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="sC" value="CONFIRMED&#xa;판매 확정 → 원장 SALE" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="190" height="56" as="geometry"/></mxCell>
        <mxCell id="sL" value="RELEASED&#xa;해제 (사유 필수)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="905" y="330" width="160" height="56" as="geometry"/></mxCell>
        <mxCell id="sE" value="EXPIRED&#xa;20분 초과" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="330" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="e387" value="예약 (판매 가능 ≥ 수량)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s0" target="sR"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e388" value="결제 승인" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sR" target="sC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e389" value="실패·이탈·재주문" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sR" target="sL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e390" value="만료 정리" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sR" target="sE"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n391" value="상태는 RESERVED에서 딱 한 번만 바뀜 (트리거)&#xa;• 확정된 예약을 되돌리기 금지&#xa;• 만료 시각이 지난 예약은 확정 금지&#xa;• 수량·SKU·주문 변경 금지 (해제 후 새로 예약)&#xa;• 삭제 금지 (기록으로 남김)" style="html=1;whiteSpace=wrap;fontSize=12;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="550" height="110" as="geometry"/></mxCell>
        <mxCell id="b1" value="InventoryBalance (자켓 블랙 100)&#xa;실재고 12 · 예약 1 · 안전재고 1&#xa;→ 판매 가능 10" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d0f0ee;strokeColor=#2f8f88;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="560" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="n392" value="실재고 = 원장 합계: +12 입고 +3 입고 −3 실사 분실 = 12&#xa;예약 = RESERVED 예약 합계&#xa;숫자를 직접 고치면 트리거가 거부 → 원장·예약으로만 변경&#xa;npm run db:verify가 합계 일치를 다시 점검" style="html=1;whiteSpace=wrap;fontSize=12;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="970" y="560" width="410" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
