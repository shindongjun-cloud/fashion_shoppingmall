%% ============================================================
%% 고객 도메인 설계 (my-shop) - 2026-11-17
%% 이 파일에는 다이어그램 3개가 들어 있습니다.
%%   [1] 전체 ERD  [2] 고객 상태 전이도  [3] 탈퇴 처리 흐름
%% Mermaid 뷰어는 보통 한 번에 다이어그램 하나만 그립니다.
%% 미리보기는 ===== 구분선 사이 블록을 하나씩 복사해 붙여넣으세요.
%% ============================================================

%% ===== [1] 전체 ERD =====
%% 고객 도메인 ERD (실무형 설계 정리)
%% 대상: 중견 B2C 쇼핑몰 기준 / 작성일 2026-11-17
%% 표기: PK 기본키, FK 외래키, UK 유니크
%% 점선(..) 관계 = 논리적 연결만 있고 FK 제약은 없음 (분리 DB, 웨어하우스 등)

erDiagram

    %% =========================================================
    %% Ⅰ. 계정 / 식별
    %% =========================================================
    customer {
        bigint   id PK "내부 키 (autoincrement)"
        string   customer_no UK "외부 노출용 고객번호"
        string   email_normalized UK "소문자 정규화 / 탈퇴 시 NULL"
        string   name "탈퇴 시 '탈퇴회원'"
        string   phone_enc "AES-256 양방향 암호문"
        string   phone_hash "검색용 HMAC (블라인드 인덱스)"
        string   password_hash "bcrypt/argon2 (소셜 전용이면 없음)"
        string   type "MEMBER / GUEST"
        string   role "USER / ADMIN"
        string   status "ACTIVE / DORMANT / SUSPENDED / WITHDRAW_PENDING / WITHDRAWN"
        string   grade_code FK
        bigint   referrer_id FK "추천인 (자기참조)"
        bigint   store_id "멀티몰일 때 (store_id, email) 유니크"
        datetime last_login_at
        datetime withdrawn_at "소프트 삭제 시각"
        int      version "낙관적 락"
        datetime created_at
        datetime updated_at
    }

    user_identity {
        bigint   id PK
        bigint   customer_id FK
        string   provider "github / kakao / naver / email"
        string   provider_user_id "UK(provider, provider_user_id)"
        string   access_token_enc "탈퇴 시 revoke 후 삭제"
        datetime created_at
    }

    customer_verification {
        bigint   customer_id PK, FK
        string   ci_hash UK "본인인증 CI 해시, 1인 1계정"
        string   di
        datetime verified_at
    }

    customer_profile {
        bigint   customer_id PK, FK "1:1 수직 분할"
        date     birth_date "선택 항목"
        string   gender "선택 항목"
        json     preferences "알림/UI 설정 (검색 안 하는 값만)"
    }

    b2b_customer {
        bigint   customer_id PK, FK "서브타입"
        string   biz_no UK "사업자등록번호"
        string   company_name
        string   ceo_name
        string   tax_email "세금계산서 수신"
    }

    customer_stats {
        bigint   customer_id PK, FK "집계 캐시 (원본은 orders)"
        bigint   total_order_amount
        int      order_count
        datetime last_order_at
        datetime refreshed_at
    }

    customer ||--o{ user_identity : "로그인 수단 N개"
    customer ||--o| customer_verification : "본인인증"
    customer ||--o| customer_profile : "부가 정보"
    customer ||--o| b2b_customer : "사업자 회원"
    customer ||--o| customer_stats : "집계"
    customer |o--o{ customer : "추천 (referrer_id)"

    %% =========================================================
    %% Ⅲ. 연관 데이터 (배송지 / 주문 / 등급 / 포인트 / 쿠폰 / 태그)
    %% =========================================================
    address {
        bigint   id PK
        bigint   customer_id FK
        string   alias "집 / 회사"
        string   recipient
        string   phone_enc
        string   zipcode
        string   addr1
        string   addr2
        boolean  is_default "UK(customer_id) WHERE is_default"
    }

    orders {
        bigint   id PK
        bigint   customer_id FK "비회원이면 NULL 가능"
        string   order_no UK
        bigint   total_price "서버가 DB 가격으로 계산"
        string   status "PENDING / PAID / SHIPPED / CANCELED ..."
        string   orderer_name "스냅샷"
        string   orderer_phone "스냅샷"
        string   ship_recipient "스냅샷 (5년 후 마스킹)"
        string   ship_phone "스냅샷"
        string   ship_zipcode "스냅샷"
        string   ship_addr1 "스냅샷"
        string   ship_addr2 "스냅샷"
        datetime created_at
    }

    order_item {
        bigint   id PK
        bigint   order_id FK
        bigint   product_id FK
        int      quantity
        bigint   price "주문 당시 가격 스냅샷"
    }

    grade {
        string   code PK "BASIC / SILVER / GOLD / VIP"
        bigint   min_amount "산정 기준 구매액"
        int      benefit_rate
    }

    grade_history {
        bigint   id PK
        bigint   customer_id FK
        string   from_grade
        string   to_grade
        string   reason "월 배치 재산정 등"
        datetime created_at
    }

    point_ledger {
        bigint   id PK
        bigint   customer_id FK
        string   type "EARN / USE / EXPIRE / CANCEL"
        bigint   amount "+적립 / -사용"
        bigint   order_id FK "관련 주문"
        datetime expires_at "적립분 유효기간"
        datetime created_at
    }

    point_usage_detail {
        bigint   id PK
        bigint   use_ledger_id FK "사용 거래"
        bigint   earn_ledger_id FK "차감된 적립 거래 (FIFO)"
        bigint   amount
    }

    coupon {
        bigint   id PK
        string   name
        string   discount_type "RATE / AMOUNT"
        int      discount_value
        datetime valid_until
    }

    coupon_issue {
        bigint   id PK
        bigint   coupon_id FK "UK(coupon_id, customer_id) 1인 1매"
        bigint   customer_id FK
        string   status "ISSUED / USED / EXPIRED"
        bigint   used_order_id FK
        datetime issued_at
    }

    wishlist {
        bigint   customer_id PK, FK
        bigint   product_id PK, FK
        datetime created_at
    }

    tag {
        bigint   id PK
        string   name UK "VIP관리 / 이탈위험 ..."
    }

    customer_tag {
        bigint   customer_id PK, FK
        bigint   tag_id PK, FK
    }

    consent_history {
        bigint   id PK
        bigint   customer_id FK
        string   consent_type "TERMS / PRIVACY / MARKETING_EMAIL / MARKETING_SMS"
        string   terms_version
        boolean  agreed "동의 / 철회"
        string   channel "WEB / APP / CS"
        string   ip
        datetime created_at "INSERT만 (2년 재확인 안내 근거)"
    }

    customer ||--o{ address : "주소록"
    customer |o--o{ orders : "주문"
    orders ||--|{ order_item : "주문 항목"
    grade ||--o{ customer : "현재 등급"
    customer ||--o{ grade_history : "등급 변경"
    customer ||--o{ point_ledger : "포인트 원장"
    point_ledger ||--o{ point_usage_detail : "사용/적립 매핑"
    orders |o--o{ point_ledger : "적립/사용 근거"
    coupon ||--o{ coupon_issue : "발급"
    customer ||--o{ coupon_issue : "보유 쿠폰"
    customer ||--o{ wishlist : "찜"
    customer ||--o{ customer_tag : "태그"
    tag ||--o{ customer_tag : ""
    customer ||--o{ consent_history : "동의 이력"

    %% =========================================================
    %% Part 1. 탈퇴 관리
    %% =========================================================
    customer_withdrawal {
        bigint   id PK
        bigint   customer_id FK
        string   status "REQUESTED / CANCELED / COMPLETED"
        string   reason_code "LOW_USAGE / PRIVACY / DISSATISFIED / REJOIN / OTHER"
        string   reason_text "길이 제한, 보관기간 설정"
        string   channel "WEB / APP / CS"
        datetime requested_at
        datetime scheduled_at "유예 종료 (예: +7일)"
        datetime completed_at
        string   processed_by "SELF / admin_id / SYSTEM"
    }

    withdrawn_archive {
        bigint   id PK "별도 스키마/DB, 접근권한 최소"
        bigint   customer_id "FK 제약 없음"
        string   retention_purpose "ECOMMERCE_CONTRACT_5Y / CONSUMER_DISPUTE_3Y"
        string   payload_enc "최소 정보만 암호화 JSON"
        datetime retain_until "만료 시 파기 배치"
        datetime created_at
    }

    rejoin_restriction {
        bigint   id PK
        string   identity_hash UK "HMAC(CI 또는 이메일), 원문 금지"
        datetime blocked_until "예: 탈퇴 후 30일"
        string   reason "REJOIN_COOLDOWN"
    }

    purge_log {
        bigint   id PK "파기 관리대장"
        string   target_type "CUSTOMER / ARCHIVE / ORDER_SNAPSHOT"
        bigint   target_id
        string   purge_type "ANONYMIZE / DELETE / ARCHIVE_EXPIRE"
        json     fields "파기한 항목명 (값은 저장 안 함)"
        string   executed_by "배치명 / admin_id"
        datetime executed_at
    }

    customer ||--o{ customer_withdrawal : "탈퇴 신청"
    customer ||..o| withdrawn_archive : "법정 보관 (분리)"
    customer ||..o{ purge_log : "파기 기록"

    %% =========================================================
    %% Part 2. 고객 이력 관리
    %% =========================================================
    customer_change_history {
        bigint   id PK "INSERT만 허용"
        bigint   customer_id FK "IDX(customer_id, created_at DESC)"
        string   change_type "PROFILE_UPDATE / PHONE_CHANGE / EMAIL_CHANGE ..."
        json     changed_fields "before/after 마스킹 값, 탈퇴 시 비식별화"
        string   actor_type "CUSTOMER / ADMIN / SYSTEM"
        bigint   actor_id
        string   reason "관리자 수정 시 필수"
        string   ip
        string   user_agent
        string   request_id "로그 추적 id"
        datetime created_at
    }

    customer_status_history {
        bigint   id PK
        bigint   customer_id FK
        string   from_status
        string   to_status
        string   reason_code "FRAUD_SUSPECTED / CHARGEBACK / DORMANT / WITHDRAW_REQUEST"
        string   memo
        string   changed_by
        datetime created_at
    }

    customer_snapshot {
        bigint   customer_id "SCD Type 2 (주로 웨어하우스)"
        string   grade
        string   region
        date     valid_from
        date     valid_to "현재 행은 9999-12-31"
        boolean  is_current
    }

    login_history {
        bigint   id PK "3개월~1년 보관, 월별 파티션"
        bigint   customer_id FK
        string   provider
        string   result "SUCCESS / FAIL_PASSWORD / FAIL_SUSPENDED / FAIL_LOCKED"
        string   ip
        string   user_agent
        string   device_id
        datetime created_at
    }

    admin_access_log {
        bigint   id PK "법정 1~2년 보관, append-only, 월 1회 점검"
        bigint   admin_id FK "role=ADMIN 인 customer"
        string   action "VIEW / SEARCH / UPDATE / DOWNLOAD / UNMASK"
        string   target "고객 id 또는 검색 조건"
        int      record_count "다운로드 건수"
        string   reason "DOWNLOAD/UNMASK 시 필수"
        string   ip
        datetime created_at
    }

    customer ||--o{ customer_change_history : "속성 변경"
    customer ||--o{ customer_status_history : "상태 전이"
    customer ||..o{ customer_snapshot : "시점 버전 (CDC/배치)"
    customer ||--o{ login_history : "로그인"
    customer ||--o{ admin_access_log : "관리자 접근 (admin_id)"

%% ===== [2] 고객 상태 전이도 =====
%% 고객 상태 전이도 (customer.status)
%% 허용된 전이만 코드에서 통과시키고, 전이할 때마다 customer_status_history에 기록

stateDiagram-v2
    [*] --> ACTIVE : 회원가입

    ACTIVE --> DORMANT : 장기 미접속 (자율 정책, 개인정보 분리 보관)
    DORMANT --> ACTIVE : 재로그인 + 본인확인

    ACTIVE --> SUSPENDED : 관리자 정지 (사기 의심, 차지백 등)
    SUSPENDED --> ACTIVE : 관리자 해제 (사유 기록 필수)

    ACTIVE --> WITHDRAW_PENDING : 탈퇴 신청 (세션 전부 삭제)
    DORMANT --> WITHDRAW_PENDING : 탈퇴 신청
    SUSPENDED --> WITHDRAW_PENDING : 탈퇴 신청 (분쟁 정리 후)
    WITHDRAW_PENDING --> ACTIVE : 유예기간 내 철회

    WITHDRAW_PENDING --> WITHDRAWN : 유예 종료 배치 (비식별화 + 분리 보관)
    WITHDRAWN --> [*] : 복구 불가 (재가입은 신규 회원)

    note right of WITHDRAWN
        행은 유지 (주문 FK 보존)
        name = 탈퇴회원, email/phone = NULL
        법정 보관분은 withdrawn_archive로 이동
    end note

%% ===== [3] 탈퇴 처리 흐름 =====
flowchart TD
    A([고객: 탈퇴 신청]) --> B{사전 검증}
    B -- "진행 중 주문 / 반품·환불 / 미정산 예치금 있음" --> B1[탈퇴 불가 안내]
    B -- 통과 --> C[소멸 고지 및 동의<br/>포인트·쿠폰 소멸]
    C --> D[customer_withdrawal 생성<br/>status = REQUESTED, scheduled_at = +7일<br/>customer.status = WITHDRAW_PENDING<br/>모든 세션 삭제]

    D --> E{유예기간 내 철회?}
    E -- 예 --> E1[status 복구 = ACTIVE<br/>withdrawal = CANCELED]
    E -- "아니오 (매일 새벽 배치)" --> F

    subgraph F [단일 트랜잭션]
        direction TB
        F1[withdrawn_archive 저장<br/>법정 보관 최소정보 암호화] --> F2[customer 비식별화<br/>status = WITHDRAWN]
        F2 --> F3[주소록 · 장바구니 · 위시리스트 삭제]
        F3 --> F4[포인트/쿠폰 소멸 원장 기록]
        F4 --> F5[변경 이력의 PII 비식별화]
        F5 --> F6[user_identity 삭제]
        F6 --> F7[withdrawal = COMPLETED<br/>purge_log 기록]
    end

    F --> G[트랜잭션 밖: 외부 처리<br/>OAuth 토큰 revoke<br/>CRM · 메일툴 · 분석툴 삭제 요청<br/>실패 시 재시도 큐]

    G --> H[(보관기간 만료 배치)]
    H --> H1[withdrawn_archive 파기<br/>계약·결제 5년 / 분쟁 3년]
    H --> H2[주문 스냅샷 PII 마스킹]
    H --> H3[로그인 이력 파기<br/>3개월~1년]
    H1 & H2 & H3 --> I[purge_log 기록]
